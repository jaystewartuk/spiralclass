{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm gate --allow-dirty:*)",
      "Bash(pnpm gate:lock)",
      "Bash(pnpm release:status)",
      "Bash(pnpm local:status)",
      "Bash(node scripts/readme-counts.mjs:*)",
      "Bash(node scripts/check-leaks.mjs:*)",
      "Bash(pnpm issue:check:*)"
    ],
    "deny": [
      "Bash(pnpm promote:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(pnpm deploy:cloudrun:*)",
      "Bash(scripts/cloudrun-deploy.sh:*)",
      "Bash(bash scripts/cloudrun-deploy.sh:*)",
      "Bash(./scripts/cloudrun-deploy.sh:*)",
      "Bash(infra/gcp/setup-deploy-identity.sh:*)",
      "Bash(bash infra/gcp/setup-deploy-identity.sh:*)",
      "Bash(infra/gcp/push-cloudrun-env.sh:*)",
      "Bash(bash infra/gcp/push-cloudrun-env.sh:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud run services replace:*)",
      "Bash(gcloud run services update:*)",
      "Bash(gcloud run services delete:*)",
      "Bash(gcloud run domain-mappings:*)",
      "Bash(gcloud secrets create:*)",
      "Bash(gcloud secrets versions:*)",
      "Bash(gcloud secrets delete:*)",
      "Bash(gcloud iam service-accounts keys:*)",
      "Bash(scripts/database-deploy.sh:*)",
      "Bash(bash scripts/database-deploy.sh:*)",
      "Bash(./scripts/database-deploy.sh:*)",
      "Bash(scripts/local/backup-prod-db.sh:*)",
      "Bash(pnpm --filter spiralclass-web migrate:prod:*)",
      "Bash(pnpm --filter spiralclass-web run migrate:prod:*)",
      "Bash(just db-migrate prod)",
      "Bash(pnpm test:e2e:*)",
      "Bash(infisical:*)",
      "Bash(* infisical *)",
      "Bash(neon:*)",
      "Bash(psql:*)",
      "Read(./config/env/*.local.env)",
      "Read(./infra/**/terraform.tfvars)",
      "Read(./infra/**/backend.hcl)",
      "Read(./apps/web/.auth/**)"
    ]
  }
}
