# LOCAL — non-secret RUNTIME config for a developer's own machine.
#
# These values are not secrets. They point at a Postgres running on this
# machine, reachable only from it, with credentials that are the same for
# everyone by design. Keeping them in the repo rather than in a private
# .env.local is the whole point: a command that needs them works on a fresh
# checkout, and there is no per-developer file to drift, to be missing, or to
# quietly hold a preview or production URL instead.
#
# Genuine secrets never come from here — they come from Infisical
# (infra/infisical/run.sh). If a value in this file ever needs to be secret,
# that is the signal it belongs in Infisical, not that this file needs
# gitignoring.
#
# Same strict grammar as the other files here: KEY=value, unquoted, no inline
# comments. See config/env/README.md.

# The local development database. `docker compose -f apps/web/docker-compose.dev.yml up`
# or any local Postgres on 5432 with these credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spiralclass
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/spiralclass

# The integration suite's own database (`pnpm test:integration:local`, which
# starts it from apps/web/docker-compose.test.yml). Port 5433 so it never
# collides with the dev database above — running both at once is the normal
# case.
#
# It is here rather than in a per-developer apps/web/.env.test for the reason
# every other value on this page is: that file is the copy nobody rotates and
# the one that goes missing. Without it the integration suites did not fail,
# they SKIPPED — `describeIntegration` is a no-op when the variable is absent —
# so `pnpm test:integration:local` reported "23 skipped" and exited 0, which is
# the worst possible shape for a check.
TEST_DATABASE_URL=postgresql://test:test@localhost:5433/spiralclass_test

# Session signing for local-only sign-in. Not a secret: it protects nothing
# that exists on this machine, and every developer's is identical anyway.
SESSION_SECRET=local-development-session-secret-not-a-secret

# Prod-vs-preview is decided by APP_URL (D-89 Phase 5 removed the VERCEL_ENV
# branch), so local has to say so explicitly or it reads as production.
APP_URL=http://localhost:3000
