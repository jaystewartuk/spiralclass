# PREVIEW — non-secret BUILD-time config (NEXT_PUBLIC_*, inlined into the
# client bundle at Docker build time). Was fly.preview.toml [build.args].
# See config/env/README.md and D-85. Non-secret by design; genuine secrets
# stay in Infisical (infra/infisical/README.md, D-66).
#
# PREVIEW-SCOPED — do NOT copy these values into production. Preview and
# production point at different R2 buckets (D-65), so these differ per
# environment even though none of them are secret.

# Marks this build as the preview environment. Read at BUILD time by
# next.config.ts to emit the X-Robots-Tag: noindex header (preview must never be
# indexed as a duplicate of production). production.build.env sets "production".
NEXT_PUBLIC_DEPLOY_ENV=preview

# Preview teacher-photos / teacher-videos buckets, r2.dev public dev URLs
# enabled 2026-07-16 during the bucket-rename cutover.
NEXT_PUBLIC_TEACHER_PHOTOS_R2_PUBLIC_URL=__LOCAL__
NEXT_PUBLIC_TEACHER_VIDEOS_R2_PUBLIC_URL=__LOCAL__

# Non-secret AND (as far as known) environment-invariant — same Sentry
# project / PostHog project / support number for preview and production today,
# but still build-time-only, so they belong here, not runtime. If that
# assumption breaks (e.g. a separate preview Sentry project), split accordingly.
NEXT_PUBLIC_SUPPORT_WHATSAPP=__LOCAL__
NEXT_PUBLIC_SENTRY_DSN=__LOCAL__
NEXT_PUBLIC_POSTHOG_KEY=__LOCAL__

# DELIBERATELY EMPTY, not a gap — per project_preview_posthog_server_key:
# setting NEXT_PUBLIC_POSTHOG_HOST makes the client bypass the /ingest proxy.
# Leave empty.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_REGION=us

# Stripe publishable key (safe to expose — not a secret) for
# @stripe/stripe-js / @stripe/connect-js's Embedded Checkout + embedded
# Connect components.
# TEST-mode key, matching the platform Stripe account's test-mode
# STRIPE_SECRET_KEY already configured for preview — preview stays
# test-mode by this repo's convention (recorded in the rotation runbook,
# which is kept privately -- see docs/security.md).
# Until the consuming code merges, this is a no-op: nothing on `main` reads
# it yet.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=__LOCAL__
