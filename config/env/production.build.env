# PRODUCTION — non-secret BUILD-time config (NEXT_PUBLIC_*, inlined into the
# client bundle at Docker build time). Was fly.production.toml [build.args].
# See config/env/README.md and D-85.
#
# Storage is unconditionally R2 (getStorageProvider() → createR2Provider);
# Supabase is fully decommissioned (D-89), so there are no NEXT_PUBLIC_SUPABASE_*
# vars in either environment anymore.

# Marks this build as production. Read at BUILD time by next.config.ts: on
# "production" NO X-Robots-Tag noindex header is emitted (preview sets "preview"
# and gets the noindex).
NEXT_PUBLIC_DEPLOY_ENV=production

# Production teacher-photos / teacher-videos R2 public buckets (SEPARATE from
# preview's — production buckets, new tokens). r2.dev public dev URLs enabled
# 2026-07-16 during the bucket-rename cutover.
NEXT_PUBLIC_TEACHER_PHOTOS_R2_PUBLIC_URL=__LOCAL__
NEXT_PUBLIC_TEACHER_VIDEOS_R2_PUBLIC_URL=__LOCAL__

# Non-secret AND environment-invariant — shared preview/production today.
NEXT_PUBLIC_SUPPORT_WHATSAPP=__LOCAL__

# Sentry DSN + PostHog key: SHARED with preview (decision 2026-07-14).
NEXT_PUBLIC_SENTRY_DSN=__LOCAL__
NEXT_PUBLIC_POSTHOG_KEY=__LOCAL__

# DELIBERATELY EMPTY (project_preview_posthog_server_key): a non-empty host
# makes the client bypass the /ingest proxy.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_REGION=us

# Stripe publishable key (safe to expose — not a secret) for
# @stripe/stripe-js / @stripe/connect-js's Embedded Checkout + embedded
# Connect components.
# LIVE-mode key — the UK platform Stripe account (D-58/D-99),
# matching the live-mode STRIPE_SECRET_KEY already configured for
# production. Until the consuming code merges, this is a no-op: nothing on
# `main` reads it yet.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=__LOCAL__
