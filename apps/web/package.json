{
  "name": "spiralclass-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "dotenv -e ../../config/env/local.runtime.env -- next dev --turbopack",
    "build": "prisma generate && next build",
    "build:standalone": "next build --turbopack",
    "start": "dotenv -e ../../config/env/local.runtime.env -- next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:local": "pnpm db:test:up && dotenv -e ../../config/env/local.runtime.env -- vitest run --project integration --passWithNoTests",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:lh": "lhci autorun --config=lighthouserc.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "dotenv -e ../../config/env/local.runtime.env -- prisma validate",
    "erd:generate": "node scripts/generate-erd-schema.mjs",
    "stripe:portal:sync": "tsx scripts/stripe/sync-portal-configuration.ts",
    "prisma:migrate": "dotenv -e ../../config/env/local.runtime.env -- prisma migrate dev && node scripts/generate-erd-schema.mjs",
    "prisma:migrate:deploy": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/migrate-regions.ts",
    "migrate:prod:status": "../../infra/infisical/run.sh production prisma migrate status",
    "migrate:prod": "../../infra/infisical/run.sh production tsx scripts/migrate-regions.ts",
    "migrate:preview:status": "../../infra/infisical/run.sh preview prisma migrate status",
    "migrate:preview": "../../infra/infisical/run.sh preview tsx scripts/migrate-regions.ts",
    "db-push:preview": "../../infra/infisical/run.sh preview prisma db push",
    "prisma:studio": "dotenv -e ../../config/env/local.runtime.env -- prisma studio",
    "seed": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/seed.ts",
    "economics:usage": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/economics-usage-extract.ts",
    "economics:usage:preview": "../../infra/infisical/run.sh preview tsx scripts/economics-usage-extract.ts",
    "uat:probe": "bash scripts/uat-probe.sh",
    "uat:verify": "../../infra/infisical/run.sh preview tsx scripts/uat-verify.ts",
    "import:roster": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/import/import.ts",
    "cleanup:roster": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/cleanup/delete-student-data.ts",
    "cleanup:focus-tags": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/cleanup/reset-focus-tags.ts",
    "backfill:homework-attempts": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/backfill/homework-attempts.ts",
    "backfill:student-locale": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/backfill/student-locale.ts",
    "wise:connect": "dotenv -e ../../config/env/local.runtime.env -- tsx scripts/wise/connect-teacher.ts",
    "format": "prettier --write .",
    "test:coverage": "vitest run --project unit --coverage",
    "mutation:spotcheck": "node scripts/mutation-spotcheck.mjs",
    "diff:coverage": "node scripts/diff-coverage.mjs",
    "design:drift": "node scripts/design-drift.mjs --report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "visual:gallery": "node scripts/visual-gallery.mjs",
    "test:visual:regression": "playwright test --config playwright.visual.config.ts tests/visual/regression.spec.ts --project=1440-light"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.73.0",
    "@spiralclass/shared": "workspace:*",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.6",
    "aws4fetch": "^1.0.20",
    "better-auth": "~1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "elkjs": "^0.12.0",
    "inngest": "^4.20.0",
    "input-otp": "^1.5.0",
    "livekit-client": "^2.22.2",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "pg-boss": "^12.30.0",
    "posthog-js": "^1.427.2",
    "posthog-node": "^5.51.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "resend": "^6.26.0",
    "sharp": "^0.35.4",
    "sonner": "^1.7.4",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/utils": "^0.5.0",
    "@dbml/core": "8.3.1",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "prisma-dbml-generator": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
