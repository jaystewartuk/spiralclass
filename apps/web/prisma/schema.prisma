// SpiralClass — Prisma schema
// Source of truth for what these models MEAN: docs/architecture/data-model.md
// for the shape, and docs/features/ for the behaviour each one carries.
//
// Portable Postgres, no vendor-specific SQL, and no Row Level Security: RLS
// was Supabase-platform-specific (auth.uid()/auth.users, anon/authenticated
// roles), never enforced against this app's own Prisma connection on any
// provider (a table owner bypasses RLS by default), and the app stopped using
// Supabase's PostgREST/Realtime layer entirely. Tenant isolation is
// application-level `teacherId` scoping — see SECURITY.md.
//
// THIS FILE IS NOT THE WHOLE SCHEMA. Everything Prisma's schema language
// cannot express lives in prisma/migrations/20260906120100_database_invariants
// — partial indexes (six of them uniqueness rules that apply only to live
// rows), 33 CHECK constraints, two GiST exclusion constraints that make a
// double-booked slot unrepresentable, NOT NULL on the scalar list columns, and
// two trigger functions (append-only audit log; booking-buffer derivation).
// Models carrying a load-bearing one say so in a comment, because nothing in
// the syntax can. The migration-drift check compares models and cannot see any
// of it either — tests/migrations/invariants.integration.test.ts is what
// notices one going missing.
// prisma/migrations/README.md explains the two-file structure.

// `relationJoins` unlocks the per-query `relationLoadStrategy` option. By
// default Prisma loads an `include` with one SEPARATE round trip per relation,
// wrapped in a transaction — so a query with ten relations costs BEGIN + ten
// SELECTs + COMMIT + DEALLOCATE ALL: thirteen sequential round trips to the
// database. That is invisible on localhost and brutal over a real network hop
// (Sentry measured the class-detail route spending ~800ms of a 1.7s response
// on round trips alone). `relationLoadStrategy: "join"` collapses them into
// ONE query using LATERAL JOINs.
//
// Opt-in PER QUERY, not a global default — see the booking query in
// (app)/dashboard/classes/[bookingId]/page.tsx. Applied only where a query
// has several relations AND sits on a hot path: "join" is not universally
// faster (a one-to-many fanning out over wide parent rows duplicates those
// parent columns across every child row), so it stays a measured choice each
// time rather than a blanket setting.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// Canonical DBML for the ERD pipeline. Regenerates automatically on every
// `prisma generate` (runs via postinstall) — output is gitignored, not
// committed, since it's fully derived from this file. It is the canonical
// current-state schema that `scripts/generate-erd-schema.mjs` parses (via
// @dbml/core) into src/lib/erd/schema.generated.json, which the in-app admin
// ERD (/admin/database) renders interactively. After a schema change, run
// `pnpm --filter spiralclass-web erd:generate` (or `pnpm prisma:migrate`,
// which does it) to refresh that JSON — a unit test fails if it goes stale.
// See docs/architecture/ERD.md for the full flow. The DBML also still works if
// you paste it into dbdiagram.io for an external drag-layout view.
generator dbml {
  provider = "prisma-dbml-generator"
  output   = "../dbml"
}

// Connection URLs are NOT here. Prisma 7 removed `url` and `directUrl` from the
// schema: the CLI reads its (unpooled) URL from prisma.config.ts, and the
// application connects through the pg driver adapter built in src/lib/prisma.ts.
// This block now says only what dialect the schema is written against.
datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum PackageStatus {
  // `pending` means a purchase intent exists but Stripe has not confirmed
  // payment. Flipped to `active` by the Stripe webhook. Bookings
  // must filter for `active` only — see booking.ts.
  pending
  active
  // `paused` keeps a package's balance intact but makes it non-bookable —
  // the booking guards filter `status === "active"`, so a paused package
  // can't be drawn against until it's resumed (flipped back to `active`).
  // Set during roster import (a teacher's pre-existing on-hold packages)
  // or via the teacher dashboard; never reached through the payment funnel.
  paused
  expired
  refunded
}

enum BookingStatus {
  scheduled
  completed
  canceled_by_student
  canceled_by_teacher
  rescheduled
  no_show
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

// The teacher-payout rail (D-113). `stripe` is a real card charge the
// platform processes and transfers on; `manual_transfer` is "the student
// follows payee instructions and the teacher confirms" — the platform never
// touches those funds. WHICH payee instructions is a separate axis
// (`Payment.instrumentId` -> TeacherPayoutInstrument), because the instrument
// is data, not a provider. Deliberately NOT shared with subscription billing:
// what a teacher pays SpiralClass is a different concern and has its own
// `SubscriptionPaymentProvider`.
enum PaymentProvider {
  stripe
  manual_transfer
}

// The rail a payment actually settled on, for analytics. Stripe is
// charge-or-fail (no partial-payment semantics) and lands as `card`. The
// manual-transfer values are exactly `PayoutInstrumentKind`, so a
// `payment_received` breakdown by rail is a breakdown by instrument with no
// join. Anything Stripe surfaces that we don't recognize collapses to
// `unknown`.
enum PaymentRail {
  card
  wise
  bank_transfer
  unknown
}

// The kinds of payee instructions a teacher can publish. Deliberately a
// CLOSED union, not a free-form payee-details builder: each kind gets typed
// columns, a CHECK constraint, and per-kind application validation (an
// 18-digit CLABE is checkable; a free-text bank-details blob is not, and an
// unvalidated payee field on a page a student pays from is the one place
// this rail could lose real money).
// D-145 removed `bank_account`, leaving one kind. The union survives because
// it is what a second kind would return through, and because dropping it would
// make `teacher_payout_instruments.kind` a column that says nothing.
enum PayoutInstrumentKind {
  wise
}

enum MaterialSendTiming {
  confirmation
  t_5d
  t_24h
  t_1h
}

// In-class "live notes" co-pilot (docs/features/classes-lesson-content.md, D-15).
// `teacher` cues are private to the teacher; `student` instructions surface on
// the student's booking detail inside the class window (visibility derived from
// the booking schedule, not a stored flag — see D-15).
enum NoteAudience {
  teacher
  student
}

// §materials-library: visibility of a library item relative to a student's
// level. `at_or_below` (default) = the student's level and every lower one;
// `exact` = only students at exactly this level (e.g. a placement test);
// `all` = everyone, including students with no level set (syllabus / intro).
enum LibraryVisibility {
  at_or_below
  exact
  all
}

enum NotificationChannel {
  push
  email
}

enum NotificationStatus {
  queued
  // Transient claim state: the dispatcher atomically flips queued → sending
  // before contacting the provider, so a concurrent/retried dispatch of the
  // same row is a no-op and can't double-send. Terminal states overwrite it.
  sending
  sent
  delivered
  failed
  // Intentionally not sent (recipient opted out of the category, link archived,
  // onboarding hold, etc.). Distinct from `failed` so delivery-failure
  // dashboards aren't polluted by deliberate suppression.
  suppressed
}

enum NotificationRecipientType {
  teacher
  student
}

// Booking-page lead lifecycle (docs/features/student-acquisition.md, D-24).
// `new` = just captured, `contacted` = teacher reached out, `converted` = became
// a paying student, `archived` = dismissed. The teacher moves a lead through
// these by hand from her dashboard.
enum LeadStatus {
  new
  contacted
  converted
  archived
}

// Where a testimonial's words came from, and therefore what the public page is
// allowed to claim about them.
//
// `teacher_curated` is the original (and still the default): the teacher types
// in something a student sent her privately — WhatsApp, email, in person. The
// platform has no way to check it, so it is never badged.
//
// `student_submitted` is written by the student themselves, signed in, against
// a pairing the platform can prove from its own records (a completed booking
// with this teacher). The teacher can hide or delete one; she can never write
// or edit one, because editing is exactly what the badge promises did not
// happen. The column pair `student_id` + `verified_at` is required for this
// variant and forbidden for the other — a CHECK constraint in the migration
// enforces that, so "verified" cannot be set by an app-layer mistake.
enum TestimonialSource {
  teacher_curated
  student_submitted
}

enum OverrideTargetType {
  booking
  package
  payment
  student
  teacher
  // Platform-scoped action with no single teacher/student/booking/payment
  // target, e.g. a UAT probe/reseed/analytics-check run (D-55).
  system
  // A LiveKit class room, for the Live Calls admin dashboard's
  // force-end-room / disconnect-participant actions. targetId is the
  // underlying Booking id the room name encodes (see lib/video/provider.ts's
  // classCallRoom) — targetId stays a real @db.Uuid this way; the room name
  // itself lives in beforeJson/afterJson.
  call
}

enum AdminRole {
  superadmin
  finance
  support
  // Narrow, non-technical roles gated by capability, not rank — see
  // lib/admin-capabilities.ts and D-55. They rank BELOW support in
  // ROLE_RANK (lib/admin.ts) so they see nothing via the rank ladder,
  // only whatever capabilities are explicitly granted to them.
  tester
  engineer
}

// Broad grouping for PlatformExpense rows — a small, stable taxonomy (unlike
// `vendor`, which is a curated app-layer string so a new vendor doesn't need
// a migration; see KNOWN_EXPENSE_VENDORS in packages/shared/src/expenses-config.ts).
enum ExpenseCategory {
  hosting
  ai
  dev_tools
  monitoring
  email
  domain
  other
}

enum WebhookProvider {
  stripe
  inngest
  livekit
}

enum DisputeStatus {
  warning_needs_response
  warning_under_review
  warning_closed
  needs_response
  under_review
  charge_refunded
  won
  lost
}

enum AccountDeletionStatus {
  // Requested by the user; will become eligible to anonymize after the
  // grace period unless cancelled.
  pending
  // Transient claim: the sweep flips pending -> anonymizing before any
  // destructive work so a "cancel deletion" arriving mid-sweep can't be
  // clobbered (it either wins the claim, or is refused because the row is no
  // longer pending).
  anonymizing
  // User cancelled the request before the grace period ended.
  cancelled
  // The Inngest job ran and the row is permanently anonymized.
  anonymized
}

enum AccountDeletionSubjectType {
  teacher
  student
}

// --- Subscriptions / monetization (docs/features/subscriptions.md) ---
//
// The platform's own billing of teachers. This is a PLATFORM charge on the
// platform (Mexican) Stripe account — never routed through Connect. The
// teacher→student payout rail (Connect separate charges & transfers) is a
// completely separate concern; do not entangle the two. See CLAUDE.md.

// Four entitlement levels. `free` is the permanent no-cost tier; the three
// paid variants (`monthly`, `annual`, `founding`) all unlock full Pro.
enum SubscriptionPlan {
  free
  monthly
  annual
  founding
}

// Billing lifecycle. `comped` is NOT here — it's a separate boolean flag on
// the row so "never charge" stays orthogonal to the billing status.
enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  free
}

// One row per billing cycle (provider-agnostic via `provider`).
enum SubscriptionInvoiceStatus {
  paid
  open
  failed
  void
}

// How a teacher paid SpiralClass for one billing cycle. Split from
// `PaymentProvider` by D-113: the two enums shared a name and a shape but
// never a meaning. On the payout rail the platform never touches the money,
// which is exactly what `manual_transfer` asserts; on the BILLING side the
// platform does receive the funds, so "manual transfer" would be the wrong
// noun. `manual` here means "recorded by an admin from a transfer the
// platform received" — today always Wise, but the rail is not the point.
enum SubscriptionPaymentProvider {
  stripe
  manual
}

// Lifecycle of a student's homework submission for one assignment (see the
// Assignment / HomeworkSubmission models below). `draft` is the student's
// work-in-progress, auto-saved and freely editable; `submitted` is a final,
// timestamped hand-in. `returned` (teacher sent it back for revision) and
// `graded` are modelled now but not yet reachable — the teacher review/grading
// surface is a deliberate future slice. "Late" is NOT a status here: it's
// derived from `submittedAt > Assignment.dueAt` at read time, so a submission
// can be both `submitted` and late without a fourth state to keep in sync.
enum HomeworkSubmissionStatus {
  draft
  submitted
  returned
  graded
}

// A teacher's response to one HomeworkAttempt (see HomeworkFeedback below).
// Distinct from HomeworkSubmissionStatus: this is the teacher's *intent*,
// which HomeworkFeedback creation maps onto the coarser submission status
// (approved -> graded; the other two -> returned, re-opening the submission
// for editing regardless of Assignment.allowResubmission — an explicit
// teacher ask always wins over the assignment's default policy).
enum HomeworkFeedbackDecision {
  approved
  resubmission_requested
  rejected
}

// --- Core tenancy ---

model Teacher {
  // Written ONLY by apps/web/scripts/seed.ts, and only on non-production
  // databases (the seed refuses a production target outright). Null on every
  // real row, forever.
  //
  // This exists because the seed's idempotent cleanup has to answer one
  // question — "did I create this row?" — and until now it INFERRED the answer
  // from email domains and id prefixes. That inference broke silently when
  // D-138 renamed the product: every fixture email moved
  // (`@agendaprofe.test` → `@spiralclass.test`, HERO_DOMAIN `agendaprofe.com` →
  // `spiralclass.com`), so previously-seeded rows stopped matching while
  // keeping the unique booking slugs and `cus_seed_*` ids the next run needed.
  // The seed became un-rerunnable on preview and stayed green everywhere the
  // database was freshly created, which is the worst possible place for that
  // bug to hide.
  //
  // A recorded marker cannot rot that way: renaming the fixtures cannot change
  // what a previous run already wrote here.
  seededAt        DateTime? @map("seeded_at") @db.Timestamptz
  // Matches better-auth's `user`(id) (D-40; preserved 1:1 from the old
  // Supabase auth.users id during the identity backfill — see migration
  // 20260704010000_backfill_better_auth_users). App code sets this on sign-up.
  id              String    @id @db.Uuid
  email           String    @unique
  name            String
  timezone        String // IANA
  // Teacher's country (ISO-3166-1 alpha-2), captured at onboarding alongside
  // the timezone. Drives Stripe Connect account creation — Stripe fixes a
  // connected account's country at creation time and NEVER lets it change, so
  // a wrong value here permanently mis-configures the teacher's payout account.
  // Also the seed for future tax-residency + charging-currency logic. Defaults
  // to "MX" (the launch market + only currently payout-supported country; see
  // SUPPORTED_CONNECT_COUNTRIES in @spiralclass/shared). A DB CHECK constraint
  // (teachers_country_iso_format) enforces the two-uppercase-letter format,
  // mirroring the phone-E.164 CHECK.
  country         String    @default("MX")
  // Teacher's pricing currency (ISO-4217), captured once at onboarding after
  // `country` is known (country decides which curated list applies) and
  // never changed afterward — same one-way-door posture as `country`:
  // existing packages/prices/payments are already denominated in it, so a
  // self-service currency change would corrupt that history (see D-64).
  // Curated by payout rail via @spiralclass/shared: Connect-circle teachers
  // (isConnectCountrySupported(country)) pick from
  // CONNECT_CIRCLE_PRICING_CURRENCIES, everyone else from
  // WISE_RAIL_PRICING_CURRENCIES. Enforced at the app layer
  // (isPricingCurrencySupported) rather than a DB CHECK enumeration, so
  // widening the curated list is a shared-package change, not a migration —
  // mirrors why SUPPORTED_CONNECT_COUNTRIES isn't a CHECK enum either.
  // Defaults to "MXN" to match every existing teacher (single-currency
  // launch). A lightweight format CHECK (three uppercase letters,
  // teachers_pricing_currency_iso_format) still guards against garbage
  // values, mirroring teachers_country_iso_format.
  pricingCurrency String    @default("MXN") @map("pricing_currency")
  // Preferred locale for outbound email templates. The product UI
  // toggle persists locale in a cookie; this column captures the teacher's
  // last-confirmed preference so server-side dispatch (no request context)
  // can pick the right language. Defaults to "en" matching the platform's
  // i18n.ts default.
  locale          String    @default("en")
  /// When a human last CHOSE this locale, as opposed to it being detected for
  /// them. Null means "nobody has picked" — the value in `locale` came from
  /// signup provisioning (Accept-Language) or a client mirroring its device.
  ///
  /// It exists because `locale` was answering two questions at once, and the
  /// automatic writer kept winning: a client that mirrored the DEVICE language
  /// on every session check-in silently reset a teacher who had deliberately
  /// picked Spanish back to English. Same lesson as D-72/D-73 — split the
  /// column rather than guess which writer meant it. Set by a language picker;
  /// never by a background mirror.
  localeChosenAt  DateTime? @map("locale_chosen_at")

  /// Reading preferences (D-140). Persisted on the person rather than in
  /// localStorage for two reasons: they must apply on the FIRST paint, before
  /// any client script runs, or the page reflows under the reader; and they
  /// must follow her between her laptop and her phone. Same treatment as
  /// `locale`, which has the same two constraints.
  ///
  /// `readingScale` is a multiplier on the root font size, not a pixel value —
  /// the browser's own font-size setting is the more effective control and this
  /// composes with it rather than overriding it.
  readingScale                     Float     @default(1) @map("reading_scale")
  /// 0 normal, 1 wide, 2 widest. Opened letter and word spacing has better
  /// support in the reading literature than any font substitution.
  readingSpacing                   Int       @default(0) @map("reading_spacing")
  /// A warm tint over the page. Helps some readers with visual stress and is
  /// reported as unhelpful by others, which is exactly why it is a choice.
  readingTint                      Boolean   @default(false) @map("reading_tint")
  // The language her PUBLIC BOOKING PAGE renders in (`/b/<slug>` and every
  // surface of that funnel — see publicFunnelLocaleFor). A FOURTH language
  // field, deliberately independent of the three above, because it answers a
  // different question: not what she teaches, not what she teaches in, not
  // what SHE reads, but what the people she sells to read.
  //
  // Those genuinely diverge, and assuming otherwise is the mistake this column
  // exists to stop repeating. The funnel was a hardcoded English until
  // 2026-08-25 ("students are English learners"), then briefly derived from
  // `locale` on the theory that a teacher shares her link into her own
  // language's network. The platform's own first teacher is the counterexample
  // to both: her UI is Spanish and she teaches Spanish TO English speakers, so
  // her buyers read English while she reads Spanish.
  //
  // NULL means "she has not chosen", which resolves to PUBLIC_FUNNEL_LOCALE
  // ("en") — the lingua franca and what every existing funnel already rendered,
  // so no live booking page changes language until a teacher picks.
  bookingPageLocale                String?   @map("booking_page_locale")
  // The language the teacher teaches IN (BCP-47, e.g. "es") — the live-caption
  // ASR/translation source language by default. Distinct from `locale` (which
  // is UI/email chrome only). Defaults to "es" matching the D-27 launch
  // direction; overridable per booking via Booking.teacherLanguageOverride.
  teachingLanguage                 String    @default("es") @map("teaching_language")
  bufferMin                        Int       @default(10) @map("buffer_min")
  // Minimum booking notice. Defaults to 24h — a full day's notice is the
  // common expectation for a scheduled class, and what onboarding teachers
  // reshaped this to. A new teacher sees this in the onboarding availability
  // step and can lower it there.
  minAdvanceH                      Int       @default(24) @map("min_advance_h")
  maxAdvanceDays                   Int       @default(60) @map("max_advance_days")
  bookingSlug                      String    @unique @map("booking_slug")
  onboardingCompleteAt             DateTime? @map("onboarding_complete_at") @db.Timestamptz
  // Activation-model signals (the teacher-activation review
  // activation audit). `onboardingCompleteAt` only means "submitted the 4/5-step
  // wizard" — availability and package templates are pre-seeded with plausible
  // defaults (see PackageTemplate/AvailabilityRule seeding in lib/auth.ts) so a
  // teacher can finish onboarding without ever touching either. These two
  // timestamps distinguish "the wizard step was genuinely (re-)submitted by
  // the teacher" from "the seed is still sitting untouched" — set on every
  // real call to saveTemplatesAction/saveAvailabilityAction (web) or the
  // equivalent mobile PUT routes, including from onboarding itself. Null means
  // never submitted past the initial seed. Feed isMarketplaceReady() in
  // @spiralclass/shared; not a hard gate on their own.
  templatesTouchedAt               DateTime? @map("templates_touched_at") @db.Timestamptz
  availabilityTouchedAt            DateTime? @map("availability_touched_at") @db.Timestamptz
  // Set once, the first time isMarketplaceReady() (in @spiralclass/shared)
  // transitions to true for this teacher — mirrors the conditional-update
  // "first transition" pattern already used for stripeChargesEnabled in the
  // Connect webhook. Exists purely to fire the `marketplace_ready` analytics
  // event exactly once per teacher; nothing reads it as a gate (the gate is
  // always the live isMarketplaceReady() computation, never this cache).
  marketplaceReadyAt               DateTime? @map("marketplace_ready_at") @db.Timestamptz
  // Set once, the first time hasPhoto && hasBio transitions to true for this
  // teacher — the "Profile Complete" sub-state of isMarketplaceReady() (see
  // the onboarding activation audit). Same one-time
  // "first transition" analytics-fire cache idiom as marketplaceReadyAt
  // above; never read as a gate.
  profileCompletedAt               DateTime? @map("profile_completed_at") @db.Timestamptz
  // E.164-formatted teacher contact phone. Has a DB CHECK constraint
  // (teachers_phone_e164_format); format is also enforced at the
  // application layer (normalizeE164).
  phoneE164                        String?   @map("phone_e164")
  // Per-teacher lifecycle notification preferences (category → on/off as a
  // partial JSON map; null/absent key = default on). The teacher analogue of
  // students.notification_prefs, gated against TEACHER_NOTIFICATION_CATEGORIES
  // in lib/notifications/preferences.ts. Only SUPPRESSIBLE categories live
  // here — money-of-record / security / billing-critical teacher notices are
  // never gated by this map (see teacherTemplateCategory).
  notificationPrefs                Json?     @map("notification_prefs")
  // Per-teacher order/visibility for the dashboard "Day to day" nav grid —
  // an array of `{key, hidden}` objects (NavKey from packages/shared/src/nav.ts).
  // NULL (the default for every existing teacher) means the canonical default
  // order with nothing hidden; see resolveDashboardTiles().
  dashboardTileOrder               Json?     @map("dashboard_tile_order")
  // Per-teacher fully-customizable dashboard *layout* — the superset of
  // dashboardTileOrder driving the mobile Home drag-and-drop customizer: an
  // ordered list of sections (fixed widget cards + reorderable tile groups),
  // each with its own hidden flag and, for tile groups, an ordered {key,hidden}
  // tile list (NavKey from packages/shared/src/nav.ts). NULL (the default for
  // every existing teacher) resolves to the canonical default layout; see
  // resolveDashboardLayout(). dashboardTileOrder is kept in sync (its "Day to
  // day" group) so the web dashboard's existing card stays consistent.
  dashboardLayout                  Json?     @map("dashboard_layout")
  // Push channel opt-out. Mirrors students.push_opt_in. Defaults to true;
  // flipped to false from the notification settings page.
  pushOptIn                        Boolean   @default(true) @map("push_opt_in")
  // Email unsubscribe. Defaults to true; transactional sends (payments,
  // Stripe, security) ignore this and always send regardless.
  emailOptIn                       Boolean   @default(true) @map("email_opt_in")
  // Gap G4 (docs/features/library-materials.md): opt-in per-teacher toggle for
  // auto-surfacing library materials at the student's level on the class page.
  // Defaults to false — a teacher who didn't ask for it doesn't get a new
  // surface pushed onto her class pages; she turns it on from settings once
  // she's built out a level-tagged library worth showing automatically.
  autoSurfaceLevelMaterials        Boolean   @default(false) @map("auto_surface_level_materials")
  // Optional teacher-authored headline rendered as the H1 on the public
  // booking page (/b/<slug>). When null the page falls back to a generic
  // "Clases con <name>" / "Classes with <name>" so non-Spanish teachers
  // aren't mislabeled. Set from Settings → Account.
  headline                         String?   @map("headline")
  // Optional short teacher bio rendered under the headline on the public
  // booking page (/b/<slug>) and used as the OG/social description. Plain
  // text, ~280 char cap enforced in the save action. Null = no bio section.
  bio                              String?   @map("bio")
  // Optional E.164 WhatsApp number the teacher explicitly opts into showing
  // on the public booking page (/b/<slug>) as a "Chat on WhatsApp" wa.me
  // link. Deliberately a SEPARATE field from `phoneE164` above — that one is
  // the private account contact channel (shown only to a student already
  // enrolled with this teacher); publishing a number on the public page is a
  // distinct consent scope and must be opted into on its own, not inherited
  // from the account field. No automated messaging involved (D-42) — this is
  // a plain wa.me deep-link, same as the kept "share on WhatsApp" buttons.
  // Same DB CHECK format as phoneE164 (teachers_public_whatsapp_e164_format);
  // enforced at the application layer via normalizeE164. Null = no button
  // shown.
  publicWhatsappE164               String?   @map("public_whatsapp_e164")
  // Storage key (within the public `teacher-photos` bucket) of the teacher's
  // profile photo, shown on the public booking page + the social/OG image.
  // Null = no photo. The public URL is derived in lib/storage/teacher-photo.ts.
  photoPath                        String?   @map("photo_path")
  // Storage key (within the public `teacher-videos` bucket) of the teacher's
  // intro video, shown on the public booking page under the hero. One object
  // per teacher (replace in place); null = no video. The public URL is derived
  // in lib/storage/teacher-video.ts. A recorded or uploaded MP4/WebM plays
  // natively on web <video> and mobile expo-video (deliberately no third-party
  // embed / WebView — see D-73). Layer 2/3 (D-73) transcribes this object for
  // the AI intro-coach, captions, and draft-bio; this key is its source of truth.
  introVideoPath                   String?   @map("intro_video_path")
  // Duration of the intro video in milliseconds, as reported by the recorder at
  // capture time. Drives the length hint in the editor and a runtime badge on
  // the public page. Null when unknown (e.g. an uploaded file).
  introVideoDurationMs             Int?      @map("intro_video_duration_ms")
  // Stripe Connect Express account id (`acct_xxx`). The platform creates
  // the account, generates a hosted onboarding link, and the teacher
  // completes KYC on Stripe. We never receive an OAuth secret/token —
  // server-side calls authenticate via the platform's secret key plus
  // either `Stripe-Account: acct_xxx` (direct charges) or
  // `transfer_data.destination` (destination charges, MVP default).
  stripeAccountId                  String?   @unique @map("stripe_account_id")
  stripeAccountLinkedAt            DateTime? @map("stripe_account_linked_at") @db.Timestamptz
  // Mirrored from `Account.charges_enabled` / `payouts_enabled` after
  // each Stripe account.updated webhook. The teacher cannot accept
  // payments until both flip true (Stripe blocks the charge attempt
  // anyway; we read the cached value to gate the UI).
  stripeChargesEnabled             Boolean   @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled             Boolean   @default(false) @map("stripe_payouts_enabled")
  // Mirrored from Account.requirements.disabled_reason on each account.updated
  // webhook (only ever set alongside a false charges/payouts flip). Lets the
  // payments UI distinguish "restricted/rejected by Stripe" from "just hasn't
  // finished KYC yet" — those looked identical before (the onboarding
  // activation audit). Null = no restriction on file (either never connected,
  // fully enabled, or Stripe hasn't reported a reason).
  stripeRequirementsDisabledReason String?   @map("stripe_requirements_disabled_reason")
  // Which platform Stripe entity (PLATFORM_REGIONS in @spiralclass/shared)
  // this teacher's charges/transfers route through. Unused for routing
  // today — there is only one region (GB, the UK entity — D-58) —
  // so it exists purely to avoid a backfill if/when a second regional entity
  // is added. Was "MX" pre-D-99; migration 20260722010000 backfilled every
  // existing row to "GB" alongside this default.
  platformRegion                   String?   @default("GB") @map("platform_region")
  // Payee instructions for the manual-transfer rail live in
  // `TeacherPayoutInstrument` rows, not in columns here (D-113). Wise used to
  // own 7 columns on this model; modelling the instrument as the provider was
  // the original error, and it made a second instrument (SPEI) cost a
  // migration instead of a row.
  // Moderation (mirror of students.disabled_at). NULL = active. When set,
  // the middleware refuses access to teacher pages, sign-in flows route
  // the teacher home, and the dashboard hides actions. Existing bookings
  // and student data are preserved.
  disabledAt                       DateTime? @map("disabled_at") @db.Timestamptz
  disabledReason                   String?   @map("disabled_reason")
  // Lightweight referral attribution (NOT the deferred referral engine — see
  // docs/features/referrals-discounts.md). Set at signup from `?ref=CODE` on the onboarding link
  // and/or by an admin tag. Drives the ambassador commission report. Null when
  // the teacher arrived organically.
  referralSource                   String?   @map("referral_source")
  // The language this teacher TEACHES — the subject itself, because the platform
  // is language-first (D-72). A BCP-47 code from the one language registry
  // (@spiralclass/shared `LANGUAGES`): "es", "fr", "nah". Null = unset.
  //
  // Replaces the old `discipline` column (D-20), which tried to be three things
  // at once — a subject name, a focus-tag seed-pack selector, and an
  // is-this-a-language flag. Under D-72 those collapse: what she teaches IS a
  // language, so one code answers all three (the pack comes from
  // src/lib/focus-packs.ts, the subject name from `languageName()`). Still not
  // an enum that gates logic.
  //
  // Distinct from `teachingLanguage` below: this is what she teaches, that is
  // what she SPEAKS while teaching it. Usually equal — an A1 French course
  // scaffolded in Spanish is exactly when they differ.
  targetLanguage                   String?   @map("target_language")
  // Secret token for the read-only iCal subscription feed
  // (/api/calendar/feed/<token>.ics). Random, unguessable, and unique so a
  // single leaked URL can be revoked by regenerating it without touching
  // SESSION_SECRET. Null until the teacher first opens their calendar-sync
  // settings, where it is lazily minted. See lib/calendar/feed-token.ts.
  calendarFeedToken                String?   @unique @map("calendar_feed_token")
  // Lesson-insights retention (D-19 item 6). Default is
  // derive-then-discard: once a lesson's transcript exists the raw per-speaker
  // audio is deleted. When a teacher opts in here, that audio is KEPT for
  // playback instead of discarded ("keep on opt-in"). Default false = discard.
  // The consent/legal model that governs ENABLING this (LFPDPPP, minors,
  // cross-border) is still pending sign-off; this column is the mechanism only.
  lessonAudioRetentionOptIn        Boolean   @default(false) @map("lesson_audio_retention_opt_in")
  // Auto-record classes (D-132). When on, the server starts the room-composite
  // recording itself once BOTH the teacher and the student are in the class
  // room, so the recording — and the insights pipeline that feeds off it — no
  // longer depends on the teacher remembering to tap Record. Defaults off;
  // toggled from Settings. It changes WHO starts the recording, never what a
  // recording is allowed to capture: the per-student insights consent (D-22)
  // and the recording indicator both parties see are untouched, and an explicit
  // Stop is never overridden (see maybeAutoStartRecording's once-per-booking
  // rule).
  autoRecordClasses                Boolean   @default(false) @map("auto_record_classes")
  // Whether a NEW student of this teacher gets `TeacherStudent.shareProgress`
  // on from the start — i.e. whether she shares each student's learning profile
  // and vocabulary review queue with them by default.
  //
  // The per-pair `shareProgress` column stays the authority for any one
  // student; this is only the value a new pairing is created with. It exists
  // because the public booking page promises the vocabulary review
  // ("web.bookingLanding.included.vocabulary"), and a promise made to a
  // stranger before they are a student cannot be gated on a per-pair column
  // that does not exist yet. Off by default, so no teacher's page makes the
  // promise until she has deliberately turned it on.
  shareProgressByDefault           Boolean   @default(false) @map("share_progress_by_default")
  // AI-crawler readability (D-73 follow-on, booking-page-ai-readability): whether
  // the intro-video TRANSCRIPT (IntroVideoAnalysis.transcript, not the video
  // itself — that's already public) may be published in the /b/<slug>
  // VideoObject JSON-LD. The video being public isn't the same decision as its
  // transcript becoming machine-readable text; this is an explicit, separate
  // opt-in, default false. Only meaningful when a transcript actually exists,
  // which only happens for a Pro teacher whose coach pipeline ran
  // (canUseIntroVideoCoach) — this column carries no tier check itself, so it's
  // inert for anyone else. Toggled from Settings → Booking page.
  introVideoTranscriptPublicOptIn  Boolean   @default(false) @map("intro_video_transcript_public_opt_in")
  // AI material style (teacher-configurable tone/register for generated
  // materials). Read once by lib/materials/handlers.ts#resolveSubject and
  // applied to every generation path (class content, library, streamed,
  // refine), so a teacher's "make it less academic" preference sticks across
  // all materials. All nullable → unset means today's behavior (no directive
  // injected). `materialTone` ∈ casual|friendly|neutral|academic;
  // `materialLearnerAge` ∈ kids|teens|adults; `materialLanguageVariety` is
  // free text (e.g. "Mexican Spanish"); `materialCustomInstructions` is a
  // bounded free-text note appended to the prompt — it never overrides the
  // language-axis or student-name safeguards (D-72).
  materialTone                     String?   @map("material_tone")
  materialLearnerAge               String?   @map("material_learner_age")
  materialLanguageVariety          String?   @map("material_language_variety")
  materialCustomInstructions       String?   @map("material_custom_instructions")
  // Default vocabulary difficulty for AI-generated materials (D-80) — a
  // separate axis from the CEFR level, which controls grammar/structure only.
  // ∈ basic|everyday|advanced|native. Null → the effective default (everyday);
  // a per-class override on bookings.vocabulary_override beats this. Read by
  // lib/materials/handlers.ts#resolveSubject, so it flows to every generation
  // path (class content, library, streamed, refine) with no call-site change.
  materialVocabulary               String?   @map("material_vocabulary")
  createdAt                        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  subscription         TeacherSubscription?
  subscriptionInvoices SubscriptionInvoice[]
  payoutInstruments    TeacherPayoutInstrument[]

  availabilityRules     AvailabilityRule[]
  blockedDates          BlockedDate[]
  googleCalendar        GoogleCalendarConnection?
  googleBusyIntervals   GoogleBusyInterval[]
  packageTemplates      PackageTemplate[]
  packages              Package[]
  teacherStudents       TeacherStudent[]
  bookings              Booking[]
  overrides             Override[]
  levels                Level[]
  focusTagCategories    FocusTagCategory[]
  focusTags             FocusTag[]
  libraryMaterials      LibraryMaterial[]
  materialPodcasts      MaterialPodcast[]
  classMaterialUses     ClassMaterialUse[]
  studentLibraryItems   StudentLibraryItem[]
  studentNotes          StudentNote[]
  contactChangesMade    StudentContactChange[]
  learningProfiles      StudentLearningProfile[]
  vocabularyReviews     VocabularyReview[]
  leads                 Lead[]
  testimonials          Testimonial[]
  discountCodes         DiscountCode[]
  discountRedemptions   DiscountRedemption[]
  referralProgram       ReferralProgram?
  referralCodes         ReferralCode[]
  referrals             Referral[]
  shareGroups           TeacherShareGroup[]
  marketingProfile      TeacherMarketingProfile?
  marketingPlans        MarketingPlan[]
  marketingActivities   MarketingActivity[]
  acquisitionEvents     AcquisitionEvent[]
  socialPreviewImages   SocialPreviewImage[]
  socialPreviews        SocialPreview[]
  messages              Message[]
  classContentTemplates ClassContentTemplate[]
  introVideoAnalysis    IntroVideoAnalysis?
  studentInvitations    StudentInvitation[]
  // Shared-primary-key one-to-one with better-auth's own table (D-40).
  authIdentity          User                      @relation(fields: [id], references: [id], onDelete: Cascade)

  // Admin/finance cross-tenant listings (/admin/teachers, the teachers
  // export, and the overview's "recent teachers" widget) all default-sort
  // platform-wide by createdAt with no per-tenant scope to lean on.
  @@index([createdAt])
  @@map("teachers")
}

model Student {
  // Written ONLY by apps/web/scripts/seed.ts, and only on non-production
  // databases (the seed refuses a production target outright). Null on every
  // real row, forever.
  //
  // This exists because the seed's idempotent cleanup has to answer one
  // question — "did I create this row?" — and until now it INFERRED the answer
  // from email domains and id prefixes. That inference broke silently when
  // D-138 renamed the product: every fixture email moved
  // (`@agendaprofe.test` → `@spiralclass.test`, HERO_DOMAIN `agendaprofe.com` →
  // `spiralclass.com`), so previously-seeded rows stopped matching while
  // keeping the unique booking slugs and `cus_seed_*` ids the next run needed.
  // The seed became un-rerunnable on preview and stayed green everywhere the
  // database was freshly created, which is the worst possible place for that
  // bug to hide.
  //
  // A recorded marker cannot rot that way: renaming the fixtures cannot change
  // what a previous run already wrote here.
  seededAt       DateTime? @map("seeded_at") @db.Timestamptz
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Linked to better-auth's `user`(id) on first sign-in (D-40; preserved 1:1
  // from the old Supabase auth.users id — see migration
  // 20260704010000_backfill_better_auth_users). Nullable so teachers can
  // provision students before they've ever signed in.
  // @unique means one login binds exactly ONE per-teacher Student row —
  // resolveLinkedStudent (lib/auth/student-link) picks the oldest rostered
  // row matching the email. The portal then operates over the IDENTITY SET:
  // the linked row plus non-moderated sibling rows sharing the same
  // normalized email (studentIdentityIds in lib/students/identity.ts) — so
  // a multi-teacher student sees every teacher's classes from one login.
  // Read-side only by design: rows are never consolidated and fields never
  // propagate (same inbox ≠ same person — a parent can enroll two kids
  // under one email). Do not move to a single global Student row; it would
  // break per-teacher RLS, consent and deletion scoping. Remaining identity
  // gaps + verification plan: docs/architecture/multi-teacher-students.md.
  authUserId     String?   @unique @map("auth_user_id") @db.Uuid
  // Intentionally nullable and NON-unique: the same person can be enrolled
  // by multiple teachers and exists as a separate Student row per teacher
  // (multi-teacher tenancy), and teacher-provisioned students may have no
  // email until they first sign in. Deletion / opt-out flows therefore key
  // off (studentId) or (email + teacher scope), never a global email
  // uniqueness assumption. Do not add a global unique index here.
  // Values are trimmed + lowercased at every write boundary (zod schemas,
  // import script; backfilled by `normalize_student_emails`). The implied
  // "one row per (teacher, email)" invariant can't be a DB constraint with
  // email living here and tenancy on teacher_students — it's enforced by
  // the advisory-locked find-or-create in src/lib/students/find-or-create.ts.
  email          String?
  phoneE164      String?   @map("phone_e164")
  name           String
  timezone       String? // IANA, optional
  locale         String    @default("en")
  /// When a human last CHOSE this locale — see Teacher.localeChosenAt for why
  /// this is separate from `locale` itself.
  localeChosenAt DateTime? @map("locale_chosen_at")

  /// Reading preferences (D-140). Persisted on the person rather than in
  /// localStorage for two reasons: they must apply on the FIRST paint, before
  /// any client script runs, or the page reflows under the reader; and they
  /// must follow her between her laptop and her phone. Same treatment as
  /// `locale`, which has the same two constraints.
  ///
  /// `readingScale` is a multiplier on the root font size, not a pixel value —
  /// the browser's own font-size setting is the more effective control and this
  /// composes with it rather than overriding it.
  readingScale         Float     @default(1) @map("reading_scale")
  /// 0 normal, 1 wide, 2 widest. Opened letter and word spacing has better
  /// support in the reading literature than any font substitution.
  readingSpacing       Int       @default(0) @map("reading_spacing")
  /// A warm tint over the page. Helps some readers with visual stress and is
  /// reported as unhelpful by others, which is exactly why it is a choice.
  readingTint          Boolean   @default(false) @map("reading_tint")
  // The student's own language (BCP-47, e.g. "en") — the live-caption
  // ASR/translation source language for the student's own speech, and the
  // target when translating the teacher. Distinct from `locale` (UI/email
  // chrome only). Defaults to "en" matching the D-27 launch direction;
  // overridable per booking via Booking.studentLanguageOverride.
  nativeLanguage       String    @default("en") @map("native_language")
  // Email unsubscribe. Defaults to true (transactional) — students
  // are presumed consenting at sign-up and flip this off by clicking the
  // footer link in any email. When false the dispatcher refuses to send
  // on the email channel; combined with push opt-out the student is
  // effectively un-reachable and the teacher must follow up manually.
  emailOptIn           Boolean   @default(true) @map("email_opt_in")
  emailOptInAt         DateTime? @map("email_opt_in_at") @db.Timestamptz
  // Push channel opt-out. Defaults to true (push delivered when a
  // device_token is registered). Flipped to false from the notification
  // settings page; the dispatcher then skips push and falls through to
  // email even when the student has active device tokens.
  pushOptIn            Boolean   @default(true) @map("push_opt_in")
  // Per-student lifecycle notification preferences (category → on/off as
  // JSON, e.g. {"class_reminders":false}); null = product defaults (all on).
  // Transactional sends (magic-link sign-in) ignore this. CSV-imported
  // students are backfilled to all-off (they never opted into platform
  // comms); funnel students stay null (they consented at checkout). The
  // dispatcher gates student lifecycle sends on this. See
  // src/lib/notifications/preferences.ts.
  notificationPrefs    Json?     @map("notification_prefs")
  // Moderation. NULL = active. When set, checkout / magic-link / booking
  // creation refuse to operate on this student. Existing bookings remain
  // so the teacher can finish out paid classes.
  disabledAt           DateTime? @map("disabled_at") @db.Timestamptz
  disabledReason       String?   @map("disabled_reason")
  // Secret token for the read-only iCal subscription feed — see the matching
  // field on Teacher. A student's feed aggregates classes across every teacher
  // they study with (their identity set). Lazily minted on first access.
  calendarFeedToken    String?   @unique @map("calendar_feed_token")
  // Storage key (within the PRIVATE `student-photos` bucket) of the
  // student's profile photo. Null = no photo. Unlike Teacher.photoPath
  // (public bucket — booking page + OG need it), students have no
  // public-facing page, so this is only ever resolved to a short-lived
  // signed URL — see lib/storage/student-photo.ts.
  photoPath            String?   @map("photo_path")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Gates the post-signup onboarding sequence (notifications priming +
  // how-booking-works), mirroring teachers.onboarding_complete_at. Scoped to
  // this row rather than the shared User because authUserId is @unique here —
  // exactly one Student row is ever "the" linked row for a given login (see
  // authUserId's comment), so it's the right place for a per-person flag.
  // Existing rows are backfilled at migration time so only students created
  // after this shipped see the new flow.
  onboardingCompleteAt DateTime? @map("onboarding_complete_at") @db.Timestamptz

  teacherStudents       TeacherStudent[]
  packages              Package[]
  bookings              Booking[]
  libraryItems          StudentLibraryItem[]
  studentNotes          StudentNote[]
  contactChanges        StudentContactChange[]
  learningProfiles      StudentLearningProfile[]
  vocabularyReviews     VocabularyReview[]
  discountRedemptions   DiscountRedemption[]
  // Reward codes reserved for this student (slice 2b referrer rewards).
  reservedDiscountCodes DiscountCode[]
  // Referral codes this student owns (as a referrer).
  referralCodes         ReferralCode[]
  // Referrals where this student is the referred friend.
  referralsReceived     Referral[]
  // Referral-ask activities targeted at this student (D-125).
  marketingActivities   MarketingActivity[]
  messages              Message[]
  invitations           StudentInvitation[]
  homeworkSubmissions   HomeworkSubmission[]
  // Testimonials this student wrote about their teacher (at most one per
  // pairing). Only `student_submitted` rows point here.
  testimonials          Testimonial[]
  // Nullable — a roster-provisioned student who has never signed in has no
  // authUserId at all yet.
  authUser              User?                    @relation(fields: [authUserId], references: [id], onDelete: SetNull)

  @@map("students")
}

// --- Teacher → Student invitations (D-83) ------------------------------------

// The lifecycle status a teacher sees for each invitation. `expired` is a
// DERIVED display state: a row stays `pending` in the DB past its expiresAt and
// the effective status is computed at read time (see lib/invitations/status.ts)
// so a background job never has to flip every lapsed row. Only `accepted` and
// `cancelled` are terminal states written to the column.
enum InvitationStatus {
  pending
  accepted
  cancelled
  // Reserved: not written today (expiry is derived), kept so the column can
  // hold a materialized expiry if a future sweep wants one.
  expired
}

// A teacher's invitation for a specific roster student to claim their account.
// The invitation ALWAYS provisions/points at a roster Student row up front
// (created with an onboarding hold, exactly like the manual "add student"
// flow) so acceptance is just: clear the hold + link the auth identity. The
// emailed link carries a high-entropy token whose SHA-256 hash is stored here
// — the raw token is never persisted, so a DB read can't leak a live link.
model StudentInvitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId        String           @map("teacher_id") @db.Uuid
  // The roster Student row this invitation provisions and, on acceptance,
  // links to an auth identity. Cascade-deleted with the student.
  studentId        String           @map("student_id") @db.Uuid
  // Normalized (trim + lowercase) at every write boundary, mirroring
  // students.email. The invitee's inbox — the acceptance target.
  email            String
  // Optional display name captured at invite time (CSV / paste / form) before
  // the student has ever signed in. Falls back to the student row's name.
  name             String?
  // SHA-256 (hex) of the raw URL token. Unique so a hash lookup resolves the
  // one invitation a token belongs to; the raw token lives only in the email.
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(pending)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz
  // Send bookkeeping. sentAt is the first successful send; lastSentAt updates
  // on every resend; resendCount powers the per-invite resend cooldown.
  sentAt           DateTime?        @map("sent_at") @db.Timestamptz
  lastSentAt       DateTime?        @map("last_sent_at") @db.Timestamptz
  resendCount      Int              @default(0) @map("resend_count")
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz
  cancelledAt      DateTime?        @map("cancelled_at") @db.Timestamptz
  // One-time "these students haven't accepted yet" teacher nudge (D-83). Stamped
  // by the pending-invite cron so each invitation nudges the teacher at most
  // once; a resend clears it (via rotate) so a re-invited student can nudge again.
  reminderSentAt   DateTime?        @map("reminder_sent_at") @db.Timestamptz
  // The auth user id that accepted, for audit + replay diagnostics. The linked
  // Student.authUserId is the authoritative link; this records who clicked.
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // At most ONE non-terminal (pending) invitation per (teacher, email) — a
  // partial unique index in the migration enforces it; terminal rows (accepted
  // / cancelled) accumulate as history. Dashboard/list queries scan by teacher
  // + status; the pending-nudge cron scans by status + sentAt.
  @@index([teacherId, status])
  @@index([studentId])
  @@index([status, sentAt])
  @@map("student_invitations")
}

model TeacherStudent {
  teacherId                 String    @map("teacher_id") @db.Uuid
  studentId                 String    @map("student_id") @db.Uuid
  customPriceNote           String?   @map("custom_price_note")
  // Grandfathering is PER PACKAGE — see `TeacherStudentTemplatePrice`.
  // A flat `custom_price_minor_units` used to live here, one number for the whole
  // pairing, and it replaced the price of WHICHEVER package the student picked:
  // a student grandfathered at the old 4-class price saw the 20-class package
  // at that price too, labelled "your agreed price", and buying it charged it.
  // The column is dropped; its values were expanded into one row per active
  // template so nobody's agreed price changed on the way through.
  // `currency` stays, denominating those rows and the note below (the teacher's
  // own pricing currency at the time she set them).
  currency                  String    @default("MXN")
  // §materials-library: the student's CEFR (or custom) level WITH THIS TEACHER.
  // Drives which library items they can browse. Null = not set yet — the
  // student then sees NO browsable library at all (not even `all`-visibility
  // items); only explicitly-assigned or class-attached materials reach them
  // (product rule, 2026-07). References the teacher's own Level row.
  levelId                   String?   @map("level_id") @db.Uuid
  // Durable student profile (docs/features/classes-lesson-content.md, D-20).
  // The "who" the teacher would otherwise re-type into ChatGPT every class:
  // `interests` (hobbies/themes to personalize examples — "cooking, football")
  // and `goals` (what they're working toward — "pass DELE B1", "business
  // English"). Free text, per (teacher, student), teacher-private and excluded
  // from the student data export like the other teacher-private columns. Fed
  // automatically into every AI class-content generation — context an external
  // chatbot structurally cannot keep. Subject-agnostic.
  interests                 String?   @map("interests")
  goals                     String?   @map("goals")
  // Teacher-facing "dar de baja": when set, this student is no longer active on
  // THIS teacher's roster. Roster-scoped, unlike the global Student.disabledAt
  // moderation flag — Teacher A archiving never affects Teacher B's link.
  // Reversible (reactivate clears it). The dispatcher suppresses lifecycle
  // notifications for an archived pairing; bookings, packages and login are
  // untouched (parking the student, not banning the account).
  archivedAt                DateTime? @map("archived_at") @db.Timestamptz
  archivedReason            String?   @map("archived_reason")
  // Silent-onboarding hold. When set, the teacher has staged this student (and
  // any mid-package balance) on her roster before the student knows the app
  // exists — the dispatcher suppresses every lifecycle notification for the
  // pairing, just like an archived link, while still letting transactional
  // sign-in through. NULL = live/normal: every existing row and every funnel
  // (self-checkout) student is live with no backfill, and "live" is the safe
  // default for any path that doesn't set it. Cleared by "go live"; orthogonal
  // to archivedAt (parked-after-the-fact vs. not-yet-introduced).
  onboardingHoldAt          DateTime? @map("onboarding_hold_at") @db.Timestamptz
  // Phase F (docs/features/lesson-insights-reports.md): when the teacher opts
  // in, this student sees their own (teacher-validated) learning profile in the
  // student app. Off by default — the teacher owns the relationship and the
  // framing, so progress is shared deliberately, not always-on.
  shareProgress             Boolean   @default(false) @map("share_progress")
  // Lesson-insights consent gate (D-22). Capturing a student's voice for the
  // insights pipeline (D-19/D-21) requires an explicit, recorded consent for
  // THIS (teacher, student) pair — the visible recording indicator alone is not
  // treated as sufficient. The teacher records consent per student; `isMinor`
  // flags that a guardian's consent is the one that counts, so a minor is
  // gated on `guardianConsentAt`
  // rather than `insightsConsentAt`. All NULL/false by default → capture is OFF
  // for every existing and new pairing until consent is deliberately recorded.
  isMinor                   Boolean   @default(false) @map("is_minor")
  insightsConsentAt         DateTime? @map("insights_consent_at") @db.Timestamptz
  guardianConsentAt         DateTime? @map("guardian_consent_at") @db.Timestamptz
  // Live-captions consent gate (the captions architecture review
  // P0). Captions are bidirectional — the student's own mic is streamed to a
  // third-party ASR/translation provider in real time — a materially more
  // direct case than the post-call insights pipeline above, so this is a
  // SEPARATE consent, not a reuse of insightsConsentAt: an adult student must
  // consent HERSELF (self-service, not teacher-attested — see
  // captionsGuardianConsentAt for the minor path, which does stay
  // teacher-attested exactly like guardianConsentAt above). isMinor is
  // shared with the insights gate above (one concept, not duplicated). All
  // NULL by default → a student's mic is never captioned until she (or her
  // guardian, via the teacher) deliberately consents. Enforced by
  // captionsConsentOk() in lib/captions/consent.ts.
  captionsConsentAt         DateTime? @map("captions_consent_at") @db.Timestamptz
  captionsGuardianConsentAt DateTime? @map("captions_guardian_consent_at") @db.Timestamptz
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: SetNull)

  templatePrices TeacherStudentTemplatePrice[]

  @@id([teacherId, studentId])
  @@map("teacher_students")
}

// Grandfathering, per package. One row = "this student pays THIS for THAT
// package", which is the thing a teacher actually needs when she reprices and
// wants her existing students held at what they were paying. A missing row
// means the catalog price applies, so grandfathering one package out of four
// is expressible; the flat column this replaces could not say which package it
// meant, and defaulted to all of them.
//
// The price is the charge on BOTH rails — there is no grandfathered transfer
// price, same call as the flat column made ("rare * rare", added if a real
// teacher asks). Rows die with their template (a teacher who deletes a package
// has nothing left to grandfather) and with the pairing.
model TeacherStudentTemplatePrice {
  teacherId     String   @map("teacher_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  priceMinorUnits Int      @map("price_minor_units")
  // Denomination recorded explicitly rather than inferred from the teacher's
  // current pricing currency, which she can change afterwards.
  currency      String   @default("MXN")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  teacherStudent TeacherStudent  @relation(fields: [teacherId, studentId], references: [teacherId, studentId], onDelete: Cascade)
  template       PackageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([teacherId, studentId, templateId])
  @@index([templateId])
  @@map("teacher_student_template_prices")
}

// --- Student acquisition (docs/features/student-acquisition.md, D-24) ---

// An inbound enquiry from a visitor to the public booking page (/b/<slug>) who
// isn't ready to buy yet but wants the teacher to reach out — the demand the
// page currently drops, since today it's buy-or-leave. Written by the public
// funnel via the privileged app Prisma connection (same path as the checkout
// Student upsert), worked by the teacher by hand from her dashboard. This is
// deliberately NOT a Student: no account, no roster row, no packages — just a
// lead the teacher follows up. Teacher-scoped; RLS is enabled as
// defense-in-depth with a teacher-owner policy (mirrors student_notes).
model Lead {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String     @map("teacher_id") @db.Uuid
  name      String
  // Stored as-is (not normalized like students.email) — a lead may never become
  // a Student, and the teacher only ever reads it to reply. Trimmed/lowercased
  // by the capture action's zod schema before write.
  email     String
  phoneE164 String?    @map("phone_e164")
  message   String?
  status    LeadStatus @default(new)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, status, createdAt])
  @@map("leads")
}

// A testimonial rendered on the public booking page as social proof, in one of
// two kinds — see TestimonialSource above.
//
// It was teacher-authored ONLY, on the stated reasoning that student reviews
// "need volume + moderation to be credible" and could wait for scale. That is a
// sound argument against RATINGS, and it was applied to the wrong thing: one
// testimonial the platform can vouch for beats one it cannot at any n, and the
// moderation burden inverts rather than growing — a curated quote asks the
// reader to trust the teacher, a student-submitted one is written by the
// student and can only be hidden by her, never edited.
//
// What made it worth revisiting is that these quotes do not sit still. The
// acquisition planner (D-125) both nags for them (page-readiness's
// `no_testimonials`) and schedules `testimonial` posts that republish them into
// public communities, so an invented quote gets amplified with the platform
// behind it. `published` lets a teacher hide one without deleting; `sortOrder`
// is manual page ordering.
// Teacher-scoped with the same owner-only RLS policy; the public page reads
// these through the privileged app connection.
model Testimonial {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId  String            @map("teacher_id") @db.Uuid
  authorName String            @map("author_name")
  // Optional one-line context under the name, e.g. "B2 student · 6 months".
  authorNote String?           @map("author_note")
  body       String
  published  Boolean           @default(true)
  sortOrder  Int               @default(0) @map("sort_order")
  source     TestimonialSource @default(teacher_curated)
  // Set together, and only for `student_submitted` (CHECK-enforced). The
  // Student row is teacher-scoped by construction — one row per (teacher,
  // email) — so this also pins the testimonial to a pairing rather than just a
  // person. Cascade on delete: once the student row is gone the platform can no
  // longer prove the claim, and an erasure request must not leave a badge
  // standing that says otherwise.
  studentId  String?           @map("student_id") @db.Uuid
  verifiedAt DateTime?         @map("verified_at") @db.Timestamptz
  // Optional author avatar stored in the teacher-photos public bucket under
  // ${teacherId}/testimonials/${testimonialId}. Null = no photo. Public URL
  // is derived via testimonialPhotoPublicUrl() in lib/storage/testimonial-photos.ts.
  photoPath  String?           @map("photo_path")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // At most ONE testimonial per (teacher, student) — a partial unique index in
  // the migration enforces it over the non-null student_id rows, so curated
  // rows (student_id NULL) stay unconstrained.
  @@index([teacherId, published, sortOrder])
  @@index([studentId])
  @@map("testimonials")
}

// --- Discounts & referrals (docs/features/referrals-discounts.md) ---

enum DiscountKind {
  percent
  fixed
}

// Where a code came from. `promo` = teacher-created promo/win-back (slice 2a).
// The `referral_*` values are reserved for slice 2b (the referred friend's
// discount and the referrer's minted reward) so the same primitive serves both.
enum DiscountOrigin {
  promo
  referral_referred
  referral_referrer
}

// Slice 2a — the reward primitive. A teacher-scoped discount code applied at
// checkout to reduce the charged amount. Teacher-funded by definition (a lower
// charge = lower settled net), so it's the teacher's own margin to give away.
// Teacher-scoped with owner-only RLS (mirrors leads/testimonials/student_notes).
model DiscountCode {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId            String         @map("teacher_id") @db.Uuid
  // Shareable token, unique per teacher. Stored normalized (upper-cased,
  // trimmed) so matching is case-insensitive without a functional index.
  code                 String
  kind                 DiscountKind
  // Exactly one of these is set per `kind` (enforced by a CHECK constraint in
  // the migration). `percentBps` is basis points (1500 = 15%); `amountMinorUnits`
  // is a fixed reduction, in the minor units of the code's own `currency`.
  percentBps           Int?           @map("percent_bps")
  amountMinorUnits       Int?           @map("amount_minor_units")
  currency             String         @default("MXN")
  origin               DiscountOrigin @default(promo)
  active               Boolean        @default(true)
  // null = unlimited total redemptions; otherwise a hard cap across all students.
  maxRedemptions       Int?           @map("max_redemptions")
  // How many times one student may use this code (default 1). Counted against
  // redemptions whose package is still pending/active (a refunded/superseded
  // purchase frees the use again).
  perStudentLimit      Int            @default(1) @map("per_student_limit")
  expiresAt            DateTime?      @map("expires_at") @db.Timestamptz
  // When set, only this student may redeem the code (slice 2b: a referrer's
  // minted reward is private to them). Null = redeemable by any of the
  // teacher's students (promo codes). Enforced in resolveAndValidateDiscount.
  reservedForStudentId String?        @map("reserved_for_student_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  teacher        Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reservedFor    Student?             @relation(fields: [reservedForStudentId], references: [id], onDelete: Cascade)
  redemptions    DiscountRedemption[]
  // Set when this code was minted as a referrer's reward (slice 2b).
  referralReward Referral?

  @@unique([teacherId, code])
  @@index([teacherId, active])
  @@map("discount_codes")
}

// One application of a discount code to one purchase. Created in the same
// transaction as the pending Package + Payment, so the discounted amount and
// the redemption record can't drift. There is no explicit reversal: a
// redemption "counts" toward limits only while its package is pending/active,
// so a refund (package → refunded) or a superseded checkout (package → expired)
// automatically releases the use and reverses the cost — no clawback wiring.
model DiscountRedemption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discountCodeId String   @map("discount_code_id") @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  packageId      String   @unique @map("package_id") @db.Uuid
  paymentId      String   @unique @map("payment_id") @db.Uuid
  // The minor units actually discounted (base price − charged price), for the
  // teacher's cost reporting and analytics.
  amountMinorUnits Int      @map("amount_minor_units")
  // Currency of `amountMinorUnits`. Always "MXN" today; recorded for provenance.
  currency       String   @default("MXN")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package      Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([discountCodeId])
  @@index([teacherId])
  @@map("discount_redemptions")
}

enum ReferralStatus {
  attributed
  qualified
  rewarded
  void
}

// Slice 2b — a teacher's referral program config (one row per teacher). Both
// rewards are expressed in the same percent/fixed shape as a discount code.
// Disabled by default; turning it on is what makes per-student referral codes
// resolvable at checkout.
model ReferralProgram {
  teacherId              String       @id @map("teacher_id") @db.Uuid
  enabled                Boolean      @default(false)
  // The referred friend's discount on their first package.
  referredKind           DiscountKind @default(fixed) @map("referred_kind")
  referredPercentBps     Int?         @map("referred_percent_bps")
  referredAmountMinorUnits Int?         @map("referred_amount_minor_units")
  // The referrer's reward, minted as a single-use, reserved discount code when
  // the friend's payment settles.
  referrerKind           DiscountKind @default(fixed) @map("referrer_kind")
  referrerPercentBps     Int?         @map("referrer_percent_bps")
  referrerAmountMinorUnits Int?         @map("referrer_amount_minor_units")
  // Currency of the fixed referred/referrer amounts. Always "MXN" today;
  // recorded for provenance.
  currency               String       @default("MXN")
  // Days the minted reward stays valid (null = no expiry).
  rewardExpiryDays       Int?         @map("reward_expiry_days")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("referral_programs")
}

// A shareable code owned by one of a teacher's students (the referrer). One per
// (teacher, student), minted lazily when the student first opens their share
// surface. The friend enters this code at checkout (or via ?ref=), which
// resolves to the teacher's referred-side discount and records a Referral.
model ReferralCode {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  ownerStudentId String   @map("owner_student_id") @db.Uuid
  code           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  owner     Student    @relation(fields: [ownerStudentId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@unique([teacherId, code])
  @@unique([teacherId, ownerStudentId])
  @@map("referral_codes")
}

// One attribution: a friend who bought through a referral code. Attributed at
// checkout (against the pending package/payment), qualified when that payment
// settles, at which point the referrer's reward code is minted (status →
// rewarded). Like a discount redemption, an attribution only "counts" while its
// package is pending/active, so a refund/superseded purchase voids it for free;
// the minted reward is additionally voided by the refund clawback helper.
model Referral {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId                String         @map("teacher_id") @db.Uuid
  referralCodeId           String         @map("referral_code_id") @db.Uuid
  // The friend (referred student) — their per-teacher roster row.
  referredStudentId        String         @map("referred_student_id") @db.Uuid
  packageId                String         @unique @map("package_id") @db.Uuid
  paymentId                String         @unique @map("payment_id") @db.Uuid
  referredDiscountMinorUnits Int            @map("referred_discount_minor_units")
  // Currency of `referredDiscountMinorUnits`. Always "MXN" today; for provenance.
  currency                 String         @default("MXN")
  status                   ReferralStatus @default(attributed)
  // The minted reward code for the referrer (set when the friend's payment settles).
  referrerRewardCodeId     String?        @unique @map("referrer_reward_code_id") @db.Uuid
  qualifiedAt              DateTime?      @map("qualified_at") @db.Timestamptz
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz

  teacher         Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  referralCode    ReferralCode  @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredStudent Student       @relation(fields: [referredStudentId], references: [id], onDelete: Cascade)
  rewardCode      DiscountCode? @relation(fields: [referrerRewardCodeId], references: [id], onDelete: SetNull)
  // The purchase that earned the referral. FK + ON DELETE CASCADE so a
  // deleted package/payment can't leave an orphaned referral (restores the
  // referential integrity the pre-Neon raw-SQL migration had — it was lost
  // when the portable baseline was regenerated from this model, which modeled
  // these as bare @unique scalars with no @relation).
  package         Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([referralCodeId])
  @@map("referrals")
}

// A Facebook group (or other community) a teacher posts her booking link in.
// The teacher curates this list; the app uses it to (a) give her a quick
// reference of where she shares and (b) drive the recurring "time to post in
// your groups again" nudge (STUDENT_ACQUISITION.md). Posting itself stays
// human-driven — Meta removed the Groups publishing API in 2024.
model TeacherShareGroup {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId    String    @map("teacher_id") @db.Uuid
  name         String
  // Optional direct link to the community.
  url          String?
  sortOrder    Int       @default(0) @map("sort_order")
  // --- Generalised to a marketing COMMUNITY by D-125 ---
  //
  // The row used to mean "a Facebook group". It now means "a place this
  // teacher can reach learners", which is the same thing for every existing
  // row (the backfill defaults `platform` to facebook_group) and a superset
  // going forward. The table keeps its name deliberately: renaming it would
  // churn the mobile API surface, the `SocialPreview.shareGroupId` relation
  // and the already-posted `utm_content` slugs derived from these ids, for
  // nothing a comment cannot buy. See D-125.
  //
  // Which platform this community lives on — a MarketingPlatform value from
  // @spiralclass/shared. Validated in the app layer rather than as a Postgres
  // enum, the same posture as `pricing_currency` (D-64) and scheme ids
  // (D-124): adding a platform is a shared-package change, not a migration.
  platform     String    @default("facebook_group")
  // What the community's own rules say about self-promotion, as the teacher
  // recorded them: open | limited | prohibited | unknown. THE load-bearing
  // field of the acquisition planner — a promotional action is never planned
  // into a community that is not `open` or `limited`, which is what keeps
  // "help her market" from becoming "help her get banned". Defaults to the
  // platform's own conservative default at insert time (`unknown` here so an
  // untouched legacy row is never assumed permissive).
  promoPolicy  String    @default("unknown") @map("promo_policy")
  // Free-text note about who is in this community ("expats in Oaxaca,
  // 30-50"). Feeds the content generator as audience context.
  audienceNote String?   @map("audience_note")
  // --- What "limited" actually means here (communities overhaul) ---
  //
  // `promoPolicy` above says whether she may promote at all; these say under
  // what conditions. They exist because `limited` was the honest answer for
  // most real groups and then told nobody anything: the teacher still had to
  // remember "Fridays only, one link a month" herself.
  //
  // STRUCTURED and enforced deterministically. Empty weekdays means ANY day —
  // the unconfigured state must never be the blocking one.
  promoWeekdays     Int[]     @default([]) @map("promo_weekdays")
  // At most one promotional post every N days, measured from the last one she
  // marked done in this community. Null = no frequency rule.
  promoEveryDays    Int?      @map("promo_every_days")
  // Explicit override of whether a tracked link may sit in the post body.
  // Null = follow the platform's own link placement. An explicit `false` wins
  // everywhere; an explicit `true` still cannot open a prohibited community.
  promoLinksAllowed Boolean?  @map("promo_links_allowed")
  // The group's rules in her own words, for everything no schema will capture
  // ("only in the Friday thread"). CONTEXT for generation, never an enforced
  // constraint — treating a sentence as a guarantee is how a safety gate
  // becomes a liability.
  promoNotes        String?   @map("promo_notes")
  // What makes a good image FOR THIS AUDIENCE, in her words. Layered on top of
  // her general instructions (teacher_marketing_profiles.meme_brief) rather
  // than replacing them.
  memeBrief         String?   @map("meme_brief")
  // Set when the teacher retires a community. Kept rather than deleted so its
  // historical acquisition results stay attributable.
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  teacher           Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // The per-group social preview (D-123). Optional: a group with none keeps
  // the teacher's default preview, or the built-in OG card.
  preview           SocialPreview?
  activities        MarketingActivity[]
  acquisitionEvents AcquisitionEvent[]

  @@index([teacherId, sortOrder])
  @@map("teacher_share_groups")
}

// --- Availability ---

model AvailabilityRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  weekday   Int // 0 = Sunday .. 6 = Saturday
  startTime String   @map("start_time") // "HH:MM" local
  endTime   String   @map("end_time")
  // IANA zone the wall-clock (weekday + HH:MM) was written against, frozen at
  // write time. Slot generation interprets the rule in THIS zone, not the live
  // Teacher.timezone — so a teacher relocating and changing their zone can't
  // silently reinterpret existing rules and desync them from already-booked
  // (UTC) instants. Backfilled from the teacher's zone at migration. See D-53.
  timezone  String   @map("timezone")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, weekday])
  @@map("availability_rules")
}

model BlockedDate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, startsAt])
  @@map("blocked_dates")
}

// Phase 3 calendar busy-import. One row per teacher who connected their Google
// Calendar; the poller reads their external "busy" times into
// GoogleBusyInterval so slot generation can exclude them. The refresh token is
// field-encrypted at rest (lib/crypto/field-encryption) when FIELD_ENCRYPTION_KEY
// is set, plaintext fallback otherwise — same additive contract as the Wise
// credentials. Read-only `calendar.readonly` scope; we never write to Google.
model GoogleCalendarConnection {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId            String    @unique @map("teacher_id") @db.Uuid
  // The connected Google account email, for display ("Connected as …").
  googleEmail          String?   @map("google_email")
  // Long-lived refresh token (field-encrypted: `v1:…` when a master key is set).
  refreshTokenEnc      String    @map("refresh_token_enc")
  // Short-lived access token cache + its expiry, refreshed on demand.
  accessToken          String?   @map("access_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz
  // Teacher can pause busy-import without disconnecting (keeps the token).
  syncEnabled          Boolean   @default(true) @map("sync_enabled")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz
  lastSyncError        String?   @map("last_sync_error")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

// The teacher's external busy intervals (UTC), replaced wholesale on each poll.
// Slot generation treats these exactly like blocked dates.
model GoogleBusyInterval {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, startsAt])
  @@map("google_busy_intervals")
}

// --- Packages ---
// Only fixed-kind packages are user-facing. The `kind` enum and the
// monthly subscription tables (`recurring_slots`, `monthly_period_quotas`)
// were removed in the post-Slice-8 cleanup migration.

model PackageTemplate {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId             String   @map("teacher_id") @db.Uuid
  name                  String
  // Optional topic this offering covers (e.g. "Conversation", "Grammar",
  // "Business Spanish"). Free text, distinct from `name` (the size/duration
  // label). Surfaced on the student's package list so a student with packages
  // across teachers/subjects can tell them apart. Null = unset (single-subject
  // teachers just leave it blank).
  subject               String?
  classCount            Int      @map("class_count")
  // Marks this template as an individual class sold one at a time (class_count
  // is always 1) rather than a multi-class package. The student pays for it at
  // the moment they reserve a slot — see lib/payments/start-checkout.ts and the
  // auto-book-on-paid Inngest function. Enforced at the application layer.
  singleClass           Boolean  @default(false) @map("single_class")
  classDurationMin      Int      @default(50) @map("class_duration_min")
  priceMinorUnits         Int      @map("price_minor_units")
  currency              String   @default("MXN")
  // The NON-CARD price. Teachers may want to discount bank transfer to pass
  // along the savings vs. Stripe processing fees, or charge the same. Null =
  // use `priceMinorUnits` for every rail. Named for the instrument until
  // D-113 — it was always the non-card price, and it applies to every
  // manual-transfer instrument, not just Wise.
  transferPriceMinorUnits Int?     @map("transfer_price_minor_units")
  // Every fixed package carries an expiration in months from
  // purchase. Required at the application layer (`packageTemplateSchema`).
  // Stays nullable in the schema so legacy rows without an expiration
  // don't break the migration; new rows always have one.
  expirationMonths      Int?     @map("expiration_months")
  archived              Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  packages Package[]

  grandfatheredPrices TeacherStudentTemplatePrice[]

  @@index([teacherId])
  @@map("package_templates")
}

model Package {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId           String        @map("teacher_id") @db.Uuid
  studentId           String        @map("student_id") @db.Uuid
  templateId          String?       @map("template_id") @db.Uuid
  classesTotal        Int           @map("classes_total")
  // Model B: COMMITTED classes = reserved (scheduled) + consumed
  // (completed / no_show / <24h cancel). Equals COUNT of this package's
  // bookings with counts_against_package = true. Available to book =
  // classesTotal - classesUsed. See Booking.countsAgainstPackage.
  // `packages_classes_used_bounds` (invariants migration) keeps this within
  // 0..classesTotal, so an overdrawn package cannot be written at all.
  classesUsed         Int           @default(0) @map("classes_used")
  // Per-package "schedule change" budget consumed so far. A reschedule and a
  // ≥24h (refundable) student cancel each increment this by 1; the allowance is
  // classesTotal (one pooled move per class). It caps churn at the package
  // level so cancel→rebook can't out-run the limit the way the old per-booking
  // reschedule_count cap allowed. See lib/cancellation/classify.ts.
  scheduleChangesUsed Int           @default(0) @map("schedule_changes_used")
  classDurationMin    Int           @default(50) @map("class_duration_min")
  pricePaidMinorUnits   Int           @map("price_paid_minor_units")
  currency            String        @default("MXN")
  customPriceMinorUnits Int?          @map("custom_price_minor_units")
  purchasedAt         DateTime      @map("purchased_at") @db.Timestamptz
  expiresAt           DateTime?     @map("expires_at") @db.Timestamptz
  // The UTC slot a student chose at checkout for a pay-at-reservation single
  // class. NULL for ordinary package purchases. Read once by the
  // auto-book-on-paid Inngest job when payment lands; if the slot was taken in
  // the meantime the paid class stays a bookable 1-class credit (no refund
  // needed). See lib/inngest/functions/auto-book-on-paid.ts.
  intendedStartUtc    DateTime?     @map("intended_start_utc") @db.Timestamptz
  status              PackageStatus @default(active)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz

  teacher            Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  template           PackageTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  payments           Payment[]
  // A discount applied to this purchase (slice 2a). Counting only redemptions
  // whose package is pending/active is what makes refund clawback automatic —
  // a refunded/superseded package's redemption simply stops counting.
  discountRedemption DiscountRedemption?
  // The referral this purchase earned, if any (slice 2b). One-to-one via
  // Referral.packageId (@unique).
  referral           Referral?

  @@index([teacherId, studentId])
  @@index([status])
  // Supports the FIFO-by-expiry credit claim: resolve a (teacher, student,
  // class length) pool's active credits, ordered by expiry. See
  // lib/booking/credit-ledger.ts.
  @@index([teacherId, studentId, classDurationMin, status])
  // /admin/packages filters platform-wide by status and default-sorts by
  // createdAt — the plain @@index([status]) above doesn't cover the sort.
  @@index([status, createdAt])
  // The package-expiry nudge (lib/notifications/package-expiry-nudge.ts) scans
  // WHERE status='active' AND expiresAt BETWEEN now AND windowEnd. status='active'
  // matches the bulk of rows, so expiresAt is the selective predicate and was
  // unindexed; this composite makes the nudge a bounded range seek.
  @@index([status, expiresAt])
  @@map("packages")
}

// --- Bookings ---

model Booking {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId               String        @map("package_id") @db.Uuid
  teacherId               String        @map("teacher_id") @db.Uuid
  studentId               String        @map("student_id") @db.Uuid
  scheduledStart          DateTime      @map("scheduled_start") @db.Timestamptz
  scheduledEnd            DateTime      @map("scheduled_end") @db.Timestamptz
  status                  BookingStatus @default(scheduled)
  // Model B quota accounting: true while this booking holds a class slot
  // against its package (scheduled = reserved, completed/no_show = consumed,
  // <24h student cancel = penalty). Flips false on ≥24h cancel, teacher
  // cancel, and reschedule (the slot moves to the replacement row). It is the
  // per-booking source of truth that lets restore/waive re-add or refund a
  // class without re-deriving the original cancel timing. Package.classesUsed
  // is the maintained aggregate: classes_used = COUNT(counts_against_package).
  countsAgainstPackage    Boolean       @default(true) @map("counts_against_package")
  rescheduleOfBookingId   String?       @map("reschedule_of_booking_id") @db.Uuid
  rescheduleCount         Int           @default(0) @map("reschedule_count")
  completedAt             DateTime?     @map("completed_at") @db.Timestamptz
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  // Teacher's buffer_min AT BOOKING TIME, snapshotted so the DB-level
  // `bookings_no_overlap_buffered` EXCLUDE constraint can enforce the buffer
  // race-proof (an EXCLUDE constraint can't join to teachers.buffer_min's
  // current value). Mirrors how package prices lock at purchase time — a
  // later buffer change doesn't retroactively resize an existing booking's
  // protection zone. Set by every insert site (book-package-slot,
  // reschedule-handler); never edited afterward. This is the only field an
  // insert needs to get right — bufferedEnd below is derived from it.
  bufferMinSnapshot       Int           @default(0) @map("buffer_min_snapshot")
  // Live-caption language override for THIS class only ("sometimes they
  // change language"). NULL means "use Teacher.teachingLanguage /
  // Student.nativeLanguage at call time" — unlike bufferMinSnapshot above,
  // this is intentionally NOT snapshotted at booking-creation time: it's
  // freely editable by the teacher any time before/during the class (no DB
  // constraint depends on it staying fixed). A language change mid-call
  // doesn't retroactively affect an already-open ASR socket — that bakes in
  // its language at mint time — so a switch takes effect on rejoin.
  teacherLanguageOverride String?       @map("teacher_language_override")
  studentLanguageOverride String?       @map("student_language_override")
  // Per-class vocabulary difficulty override (D-80) — beats the teacher's
  // account-level `teachers.material_vocabulary` default for THIS class's AI
  // generation. ∈ basic|everyday|advanced|native. NULL = inherit the teacher
  // default (which itself falls back to the global default, everyday). Freely
  // editable from the class content compose surface; not snapshotted (no DB
  // constraint depends on it), same as the caption-language overrides above.
  vocabularyOverride      String?       @map("vocabulary_override")
  // scheduledEnd + bufferMinSnapshot, entirely DB/trigger-owned
  // (bookings_set_buffered_end_trigger, in the invariants migration) — a
  // BEFORE INSERT trigger unconditionally recomputes it from those two
  // columns on every row, so it can never drift out of sync. It is NOT set
  // by application code. `bookings_no_overlap_buffered` indexes THIS column
  // rather than a live `scheduled_end + interval` expression because
  // Postgres marks `timestamptz + interval` STABLE, not IMMUTABLE (it can't
  // statically prove the interval has no calendar-relative component, which
  // would be timezone-dependent) — confirmed empirically on preview across
  // two failed migration attempts before this one. `@default(now())` is a
  // meaningless placeholder that only exists so Prisma treats this field as
  // optional on create(); the trigger overwrites it before the row is ever
  // written, so the placeholder value never persists.
  bufferedEnd             DateTime      @default(now()) @map("buffered_end") @db.Timestamptz

  package             Package                  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  teacher             Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student             Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  rescheduleOf        Booking?                 @relation("Reschedule", fields: [rescheduleOfBookingId], references: [id], onDelete: SetNull)
  reschedules         Booking[]                @relation("Reschedule")
  // Private, booking-scoped materials (D-69) — a file/link sent on a schedule,
  // or the class's AI/typed lesson content (bookingId set, sendTiming null).
  materials           LibraryMaterial[]
  // Reusable library items attached to this class (gap G3) — distinct from
  // `materials` above: these are shared, level-gated items that also exist
  // independently of this booking.
  libraryMaterials    BookingLibraryMaterial[]
  // Teacher-private "this was opened during the class" records (any material,
  // booking-scoped or library) — see ClassMaterialUse.
  materialUses        ClassMaterialUse[]
  lessonNotes         LessonNote[]
  lessonSummary       LessonSummary?
  callRecordings      CallRecording[]
  lessonAudio         LessonAudio[]
  lessonTranscript    LessonTranscript?
  lessonInsights      LessonInsight[]
  lessonPronunciation LessonPronunciation?
  lessonBrief         LessonBrief?
  // Homework assignments the teacher attached to this class. A student submits
  // against these from the mobile class-detail screen (HomeworkSubmission).
  assignments         Assignment[]

  @@index([teacherId, scheduledStart])
  @@index([studentId, scheduledStart])
  @@index([status])
  @@index([packageId, status])
  // The hourly auto-complete sweep (lib/inngest/functions/auto-complete-sweep.ts)
  // scans WHERE status='scheduled' AND scheduledEnd < cutoff ORDER BY scheduledEnd.
  // The plain @@index([status]) can't narrow the scheduledEnd range or serve the
  // sort — on the highest-growth table (every future class is 'scheduled') that's
  // a widening scan. This composite turns it into a bounded range seek.
  @@index([status, scheduledEnd])
  @@map("bookings")
}

// text: an ordinary authored cue/instruction. bookmark: a one-tap in-call
// marker (D-97 in-call bookmarks) — no reused position sequence with text
// notes, excluded from the notes panel/teleprompter/AI summary/copy-forward,
// and its replay-relative timestamp is DERIVED at read time from
// createdAt vs. the booking's earliest LessonAudio.startedAt (the same
// 0-basis normalizeTimeline already rebases transcript utterances onto — see
// lib/transcription/merge.ts) rather than stored, so it needs no clock sync
// with the live call.
enum NoteKind {
  text
  bookmark
}

// In-class live note — a per-booking cue (teacher) or instruction (student).
// Sibling of ClassMaterial: materials are files sent ahead of time; notes are
// short text shown at class time. Tenant-scoped by teacherId like every
// other per-class row. See docs/features/classes-lesson-content.md + D-15.
model LessonNote {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String       @map("booking_id") @db.Uuid
  teacherId String       @map("teacher_id") @db.Uuid
  audience  NoteAudience
  body      String
  position  Int
  kind      NoteKind     @default(text)
  // Teacher checks a cue off mid-class (teacher audience only). Kept as a
  // timestamp, not a boolean, so the later AI summary has a "done at" breadcrumb.
  doneAt    DateTime?    @map("done_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, audience, position])
  @@index([teacherId])
  @@map("lesson_notes")
}

// A homework assignment attached to one class (Booking). The teacher authors it;
// the student sees it on the mobile class-detail screen and submits a
// HomeworkSubmission. Booking-scoped like LessonNote/LibraryMaterial and
// tenant-scoped by teacherId, so a class's homework cascades away with
// the class. Only draft/submitted are user-reachable today; `allowResubmission`
// and the returned/graded lifecycle are wired for the future teacher review
// slice without needing a schema change then.
model Assignment {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId                String    @map("booking_id") @db.Uuid
  // Denormalized tenant column (mirrors lesson_notes) — the creating teacher.
  teacherId                String    @map("teacher_id") @db.Uuid
  title                    String
  // Free-text instructions/description, Markdown-friendly. Null when the title
  // says it all.
  instructions             String?
  // When it's due. Null = no due date (submit any time, never "late").
  dueAt                    DateTime? @map("due_at") @db.Timestamptz
  // Whether a submission after `dueAt` is still accepted (default true — a late
  // hand-in is flagged, not blocked). Enforced server-side on submit.
  allowLateSubmission      Boolean   @default(true) @map("allow_late_submission")
  // Whether a student may re-open and re-submit after a first submission. When
  // false, a `submitted` submission is final (the mobile UI locks editing).
  allowResubmission        Boolean   @default(false) @map("allow_resubmission")
  // Optional provenance: set when this assignment was drafted from a class's
  // AI/teacher-authored material rather than authored from scratch — lets the
  // student screen show (and a future AI review read) the homework/exercise
  // section of that material instead of duplicating its text here. Both null
  // for a manually-authored assignment (the only path today).
  sourceMaterialId         String?   @map("source_material_id") @db.Uuid
  // Pins the exact MaterialRevision the assignment was drafted from, so a
  // later edit to the material doesn't retroactively change what the student
  // was actually assigned. Populated by whatever later creates the auto-draft
  // (not yet built) — a manually-authored assignment leaves this null even if
  // sourceMaterialId is set.
  sourceMaterialRevisionId String?   @map("source_material_revision_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking        Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sourceMaterial LibraryMaterial?     @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  sourceRevision MaterialRevision?    @relation(fields: [sourceMaterialRevisionId], references: [id], onDelete: SetNull)
  submissions    HomeworkSubmission[]

  @@index([bookingId, createdAt])
  @@index([teacherId])
  @@index([sourceMaterialId])
  @@map("assignments")
}

// One student's submission for one assignment. Exactly one row per
// (assignment, student) — the draft is upserted as the student types and then
// flipped to `submitted` on hand-in, so the same row carries the work from
// scratch through final submission (and, later, teacher return/grade). Files
// live in the child HomeworkSubmissionFile table; the text answer is inline.
// Tenant column (teacherId) denormalized from the assignment, for tenant scoping.
model HomeworkSubmission {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String                   @map("assignment_id") @db.Uuid
  studentId    String                   @map("student_id") @db.Uuid
  teacherId    String                   @map("teacher_id") @db.Uuid
  // The typed answer (Markdown-friendly plain text). Null/empty when the
  // student only attached files.
  textResponse String?                  @map("text_response")
  status       HomeworkSubmissionStatus @default(draft)
  // Set when status first becomes `submitted`; preserved thereafter so "late"
  // (submittedAt > assignment.dueAt) and the hand-in timestamp stay stable even
  // if the student later resubmits an allowed reopen.
  submittedAt  DateTime?                @map("submitted_at") @db.Timestamptz
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  assignment Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files      HomeworkSubmissionFile[]
  // Append-only snapshot per submit (first submission + every resubmission),
  // in submission order. This row keeps meaning exactly what it means today
  // ("current state"); attempt/feedback history lives alongside it, not in it.
  attempts   HomeworkAttempt[]

  // One submission per student per assignment — the draft/submit upsert key.
  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([teacherId])
  @@map("homework_submissions")
}

// A file attached to a homework submission. Private object in the shared
// `class-materials` R2 bucket under a `homework/` key prefix, downloaded only
// through a short-lived signed URL minted for the owning student or an
// authorized teacher — never public. Multiple files per submission.
model HomeworkSubmissionFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  // Denormalized tenant column (mirrors the parent submission), for tenant scoping.
  teacherId    String   @map("teacher_id") @db.Uuid
  // R2 object key under the `class-materials` bucket. Server-chosen, never
  // client-trusted (validated against the homework/ prefix on finalize).
  storagePath  String   @map("storage_path")
  // Original filename the student picked, for display.
  fileName     String   @map("file_name")
  // MIME type (application/pdf, .../wordprocessingml.document, etc.).
  fileType     String   @map("file_type")
  // Size in bytes, read back from R2 via HEAD on finalize (not client-trusted).
  fileSize     Int      @map("file_size")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  // Set once the attaching submit finalizes (whichever HomeworkAttempt that
  // submit created); null while the file is just a draft attachment, not yet
  // part of a submitted attempt.
  attemptId    String?  @map("attempt_id") @db.Uuid

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attempt    HomeworkAttempt?   @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([submissionId, uploadedAt])
  @@index([teacherId])
  @@index([attemptId])
  @@map("homework_submission_files")
}

// An immutable snapshot of one submit action — created each time a student
// finalizes a submission (the first submit, and every resubmission after a
// teacher's `resubmission_requested`/`rejected` feedback). HomeworkSubmission
// keeps meaning "current state" exactly as it does today; this table is the
// history/grading surface layered alongside it, so shipped autosave/submit
// behavior needs zero changes for this to exist.
model HomeworkAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  // 1-based, per submission — first submit is 1, first resubmission is 2, etc.
  attemptNumber Int      @map("attempt_number")
  // Snapshot of the text response at the moment of this submit (independent
  // of whatever the submission's mutable draft holds afterward).
  textResponse  String?  @map("text_response")
  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  submission     HomeworkSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  files          HomeworkSubmissionFile[]
  feedback       HomeworkFeedback?
  aiReviewDrafts HomeworkAiReviewDraft[]

  @@unique([submissionId, attemptNumber])
  @@index([submissionId])
  @@map("homework_attempts")
}

// The teacher's response to one HomeworkAttempt: free-text feedback, an
// optional score, and a decision (see HomeworkFeedbackDecision above). One row
// per attempt (@unique) — a resubmission is a new attempt with its own
// feedback, so earlier rounds are never overwritten. Only ever created by an
// explicit teacher action; content is what's shown to the student (an edited
// copy of an AI draft, or written from scratch) — the AI draft itself never
// is. Score scale (points/percentage/letter) is intentionally unconstrained
// here pending product sign-off — see docs/features/homework.md.
model HomeworkFeedback {
  id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId String                   @unique @map("attempt_id") @db.Uuid
  // Denormalized tenant column, matching the rest of the homework tables.
  teacherId String                   @map("teacher_id") @db.Uuid
  decision  HomeworkFeedbackDecision
  content   String
  score     Int?
  // Which AI draft (if any) this feedback started from — purely informational
  // (the content here may be an edited copy, not a verbatim approval).
  aiDraftId String?                  @map("ai_draft_id") @db.Uuid
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  attempt HomeworkAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  aiDraft HomeworkAiReviewDraft? @relation(fields: [aiDraftId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@map("homework_feedback")
}

// A teacher-triggered AI review draft for one attempt ("Review with AI" /
// "Regenerate") — retained (not a throwaway API response) so history stays
// auditable: which drafts a teacher used or discarded, which model produced
// them, for later cost/accuracy analytics. NEVER shown to the student
// directly — only what a teacher explicitly approves into a
// HomeworkFeedback.content is ever visible to them (see that model's doc).
model HomeworkAiReviewDraft {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId    String    @map("attempt_id") @db.Uuid
  teacherId    String    @map("teacher_id") @db.Uuid
  // Optional teacher steer for this specific review, e.g. "focus on the
  // subjunctive mood" or "go easy on articles."
  instructions String?
  // { corrections[], strengths[], weaknesses[], grammarNotes[]?,
  //   suggestedFeedback, suggestedScore? } — shape owned by the AI-review lib
  // code, not enforced at the DB layer.
  content      Json
  // Model id used, e.g. "claude-sonnet-5" — for future auditing/upgrades.
  model        String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Set when the teacher regenerated or dismissed this draft instead of using
  // it — never deleted, so the full history of what the AI suggested stays.
  discardedAt  DateTime? @map("discarded_at") @db.Timestamptz

  attempt           HomeworkAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  resultingFeedback HomeworkFeedback[]

  @@index([attemptId, createdAt])
  @@index([teacherId, createdAt])
  @@map("homework_ai_review_drafts")
}

// How a ClassContent.body was authored: typed by the teacher, or drafted by the
// in-app AI compose action and then reviewed/edited by the teacher. Both end up
// as teacher-owned content; this only records provenance for analytics.
enum ClassContentSource {
  manual
  ai
}

// Lifecycle of a material's generated podcast (MaterialPodcast below). NULL is
// not a value here — a material with no podcast simply has no MaterialPodcast
// row. `pending` is set the moment generation is requested and an Inngest job
// enqueued; the job flips it to `ready` (audio uploaded) or `failed`.
enum PodcastStatus {
  pending
  ready
  failed
}

// One row per successful AI class-content generation, used only to enforce the
// per-teacher monthly cap (D-17: Pro + a monthly ceiling on AI spend). Tenant
// column without a teachers FK, mirroring lesson_notes — app code scopes reads
// by teacher_id and RLS is the defense-in-depth gate.
model ClassContentGeneration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([teacherId, createdAt])
  @@map("class_content_generations")
}

// A teacher-authored, reusable lesson skeleton (docs/features/classes-lesson-content.md
// task 3) — "start a new booking's content from a template" instead of retyping
// the same structure. Teacher-scoped, NOT booking- or level-scoped (unlike
// LibraryMaterial, which requires a level for the student-facing browse surface;
// a template is teacher-private and never shown to a student). Authoring
// (create) is Pro-gated like the rest of class-content authoring; using an
// existing template to seed the editor is just a client-side copy, same as
// picking a library item never differently paywalls.
model ClassContentTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  label     String
  body      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, position])
  @@map("class_content_templates")
}

// AI post-class summary — one teacher-private recap per booking, generated from
// the class's live notes after it ends (live-notes-panel.md "step 2", D-15).
// Teacher-only: never shown to a student, so there is no student RLS policy.
model LessonSummary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  body      String
  // The model id that produced this body (provenance + future re-gen logic).
  model     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("lesson_summaries")
}

// A recording of the in-class video call (LiveKit Egress → S3/Supabase Storage).
// Teacher-initiated and teacher-only — like lesson_summaries there is no student
// column and no student RLS. A booking can hold several (start/stop more than
// once). Recording is a Pro feature gated in the action; egress availability is
// gated by recordingEnabled() (lib/video/recording.ts).
model CallRecording {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  teacherId  String    @map("teacher_id") @db.Uuid // denormalized for tenant isolation + owner RLS
  egressId   String    @unique @map("egress_id") // LiveKit egress id, used to stop it
  storageKey String    @map("storage_key") // object key in the egress bucket
  status     String    @default("recording") // recording | completed | failed
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([teacherId])
  @@map("call_recordings")
}

// Per-participant, audio-only capture of an in-class call — the raw material the
// lesson-insights pipeline consumes (docs/features/lesson-insights-reports.md,
// D-19). A SEPARATE table from call_recordings because the retention lifecycle
// differs: the A/V recording is kept on teacher opt-in, whereas this analysis
// audio is derive-then-discard — transcribed, then the audio is deleted. Phase A
// only lands the file and fires `lesson.audio.ready`; transcription/discard are
// Phase B. Teacher-only, owner RLS (tenant isolation), exactly like call_recordings — the
// consent surface is the same visible "Recording" indicator, since this rides
// the teacher's Record action.
enum LessonAudioSpeaker {
  student
  teacher
}

model LessonAudio {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String             @map("booking_id") @db.Uuid
  teacherId  String             @map("teacher_id") @db.Uuid // denormalized for tenant isolation + owner RLS
  speaker    LessonAudioSpeaker // which participant this track captures
  egressId   String             @unique @map("egress_id") // LiveKit track-egress id, used to stop it
  storageKey String             @map("storage_key") // object key in the egress bucket
  // recording → ready (file in R2) → transcribed → deleted (audio discarded).
  // Phase A only drives recording → ready; the rest lands with Phase B.
  status     String             @default("recording")
  durationMs Int?               @map("duration_ms")
  startedAt  DateTime           @default(now()) @map("started_at") @db.Timestamptz
  endedAt    DateTime?          @map("ended_at") @db.Timestamptz
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([teacherId])
  @@map("lesson_audio")
}

// Speaker-labelled, word-timestamped transcript of a lesson — the output of
// Phase B (docs/features/lesson-insights-reports.md, D-19) and the input to
// Phase C analysis. ONE row per booking: the two per-speaker LessonAudio files
// are transcribed independently (so each speaker is KNOWN, no diarization) and
// merged into a single timeline here. Teacher-only, owner RLS (tenant isolation), exactly
// like lesson_summaries — a transcript is never exposed to a student.
//
// `utterances` is JSON, not a child table, because Phase C reads it whole and it
// is never queried by-utterance:
//   [{ speaker: "student"|"teacher", text, startMs, endMs,
//      words: [{ text, startMs, endMs, confidence }] }]  // ordered by startMs
model LessonTranscript {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid // denormalized for tenant isolation + owner RLS
  language   String // BCP-47 tag of the lesson's target language (Spanish-first: "es")
  utterances Json // merged, speaker-labelled, word-timestamped — see above
  provider   String // "deepgram" | "assemblyai" — ASR provenance
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("lesson_transcripts")
}

// Async analysis of a teacher's public intro video (D-73, Layer 2). One row per
// teacher (1:1). Layer 2 fills `transcript` via batch ASR (Deepgram) run on the
// public video URL when the teacher records/uploads; Layer 3 will add the AI
// coach feedback, captions (VTT) and draft bio/headline derived from it (their
// own migration). Pro-gated (`canUseIntroVideoCoach`) and behind
// `INTRO_VIDEO_COACH_ENABLED` — dormant until both hold. Unlike lesson
// transcripts this is the teacher's OWN public video (no student data, no
// minors), so D-19's consent/retention model doesn't apply.
enum IntroVideoAnalysisStatus {
  pending
  transcribing
  transcribed
  failed
}

model IntroVideoAnalysis {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId     String                   @unique @map("teacher_id") @db.Uuid
  // The storage key (Teacher.introVideoPath) this analysis was computed from, so
  // a re-record or a cleared video is detectable and the stale analysis re-run.
  videoPath     String                   @map("video_path")
  status        IntroVideoAnalysisStatus @default(pending)
  // BCP-47 tag used for ASR — from teacher.teachingLanguage (the language she
  // SPEAKS). Deliberately NOT targetLanguage, which is the subject she teaches
  // (D-72). The two coincide for a teacher of Spanish who teaches in Spanish,
  // which is what masked this for so long; they diverge for a teacher OF
  // English who teaches IN Spanish, whose audio then went to the vendor tagged
  // "en". See docs/decisions/D-73.md's 2026-07-29 amendment.
  language      String?
  provider      String? // "deepgram" | "assemblyai" — ASR provenance
  // Transcript utterances JSON: [{ text, startMs, endMs }] ordered by startMs.
  transcript    Json?
  // AI coach feedback (D-73, Layer 3): { overall, strengths[], improvements[] }.
  // Generated from the transcript after ASR; null until analysed (or if it fails
  // — best-effort, never blocks the transcript). Teacher-only, never public.
  coachFeedback Json?                    @map("coach_feedback")
  error         String? // last failure reason, for retry/debug
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("intro_video_analyses")
}

// Categorised, evidence-anchored focus areas derived from a lesson transcript —
// the output of Phase C (docs/features/lesson-insights-reports.md, D-19) and
// the structured evolution of the free-text lesson_summaries. Teacher-only,
// owner RLS (tenant isolation), like lesson_summaries — never shown to a student.
//
// Phase C writes source="ai", confirmedAt=null rows (read-only, AI-suggested).
// The teacher confirm/edit/dismiss loop and the longitudinal profile rollup are
// Phase E — confirmedAt/dismissedAt/source are reserved here so Phase E adds no
// migration to this table.
enum InsightCategory {
  pronunciation
  grammar
  vocabulary
  fluency
  comprehension
}

model LessonInsight {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String          @map("booking_id") @db.Uuid
  teacherId   String          @map("teacher_id") @db.Uuid // denormalized for tenant isolation + owner RLS
  category    InsightCategory
  summary     String // the finding, e.g. "Confuses ser/estar with emotions"
  // Canonical grouping key for the longitudinal profile (Phase E,
  // lib/lesson-notes/skills.ts), e.g. "ser_vs_estar". Set when the teacher
  // confirms; null on unconfirmed AI rows.
  skill       String?
  evidence    String? // the student's actual words this is anchored to
  suggestion  String? // correct form / drill / target
  atMs        Int?            @map("at_ms") // moment in the lesson timeline (for playback)
  source      String          @default("ai") // "ai" | "teacher" — Phase E adds teacher-authored
  confirmedAt DateTime?       @map("confirmed_at") @db.Timestamptz // Phase E
  dismissedAt DateTime?       @map("dismissed_at") @db.Timestamptz // Phase E
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, category])
  @@index([teacherId])
  @@map("lesson_insights")
}

// Pronunciation scores from the student's audio — Phase D
// (docs/features/lesson-insights-reports.md, D-19). The one dimension a
// transcript can't give: phoneme-level accuracy from the recording. Scored
// inside the Phase B pipeline while the audio is still present (before the
// derive-then-discard step), then read by Phase C so its pronunciation findings
// are audio-grounded. Teacher-only, owner RLS (tenant isolation). One row per booking.
model LessonPronunciation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid // denormalized for tenant isolation + owner RLS
  language  String // BCP-47 the scoring ran against
  // { overall: { accuracy, fluency, completeness, pron },
  //   weakWords: [{ word, accuracy, atMs, phonemes?: [{ phoneme, accuracy }] }] }
  scores    Json
  provider  String // "azure" — scoring provenance
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("lesson_pronunciation")
}

// Materialised per-student learning profile — Phase E
// (docs/features/lesson-insights-reports.md, D-19). A rollup of the student's
// CONFIRMED insights (the teacher-validated ones; unconfirmed AI never feeds it),
// grouped by category+skill with recurrence + trend, plus a vocabulary queue.
// NOT a source of truth — recomputed from lesson_insights on every validation
// mutation. Teacher-only, owner RLS (tenant isolation). One row per (teacher, student).
model StudentLearningProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  // computeProfile() output; shape lives in code (Zod-validated). See
  // lib/lesson-notes/profile.ts.
  profile   Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@map("student_learning_profiles")
}

// Pre-class teacher brief — Phase F (docs/features/lesson-insights-reports.md,
// D-19). Closes the loop: built on-demand from the student's
// StudentLearningProfile when the teacher opens the UPCOMING class, it proposes
// what to focus on and ≤3 suggested cues the teacher can stage into the live
// notes with one tap. Cached one-per-booking; regenerated when the profile
// changed since (generatedAt vs the profile's updatedAt). Teacher-only, owner
// RLS (tenant isolation). Read-only derivative — never writes back into the profile.
model LessonBrief {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String   @unique @map("booking_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid // denormalized for tenant isolation + owner RLS
  // buildBriefPrompt output, Zod-validated in code:
  // { summary, focus: [{ skill, category, why, suggestedCue }], vocabulary: [term] }
  content     Json
  model       String // provenance, e.g. "claude-haiku-4-5"
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("lesson_briefs")
}

// Spaced-repetition state for a student's vocabulary — Phase F, Half 2
// (docs/features/lesson-insights-reports.md, D-19). The profile's vocabulary
// queue is a derived list with NO scheduling state and is clobbered on every E
// recompute, so SRS state must live OUTSIDE the profile: here. Seeded/topped-up
// from the queue (the @@unique makes re-seeding a no-op that preserves
// scheduling). One row per (teacher, student, term). Teacher-only, owner RLS
// (tenant isolation); the student app reads/reviews via app-scoped queries (identity set).
model VocabularyReview {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId      String    @map("teacher_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  term           String // the vocabulary term to review
  intervalDays   Int       @default(0) @map("interval_days")
  easeFactor     Float     @default(2.5) @map("ease_factor") // SM-2 style
  dueAt          DateTime  @map("due_at") @db.Timestamptz
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId, term])
  @@index([studentId, dueAt])
  @@map("vocabulary_reviews")
}

// --- Level-gated material library (docs/features/library-materials.md) ---

// A teacher's ordered level ladder. Seeded with CEFR (a1..c2) for every
// teacher via ensureTeacherLevels (src/lib/levels.ts); editable later via a
// settings screen (not in v1). NOT a fixed enum so non-language teachers can
// use their own ladders (Grade 7/8/9, Beginner/Intermediate/Advanced) without
// a migration.
model Level {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  code      String // stable key, e.g. "a1"; unique per teacher
  label     String // display, e.g. "A1" / "Grade 7" / "Principiante"
  position  Int // 1-based rank; "level and below" compares this
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher          Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  libraryMaterials LibraryMaterial[]
  teacherStudents  TeacherStudent[]

  @@unique([teacherId, code])
  @@unique([teacherId, position])
  @@index([teacherId, position])
  @@map("levels")
}

// A teacher's reusable "what to work on" tags — the structured pedagogical
// inputs she would otherwise type into ChatGPT every class (a grammar point, a
// vocabulary domain, a skill, an activity type, a theme). Seeded per the
// teacher's discipline (src/lib/focus-tags.ts) — a Spanish/language pack first,
// with music/math/generic packs — exactly like the CEFR-seeded Level table:
// sensible defaults with zero setup, but a teacher-scoped TABLE (not an enum)
// so it never locks the platform to one subject. The teacher picks tags when
// generating class content; the labels seed the AI prompt. `category` is an
// optional soft grouping ("grammar" / "vocabulary" / "skill" / "activity" /
// "theme") used only to organize the picker. Editing/adding tags is additive
// (a later settings screen); in v1 the seed IS the UI, like levels.
// docs/features/classes-lesson-content.md, D-20, Layer 2.
// A teacher-scoped, teacher-manageable grouping for focus tags — "Grammar",
// "Vocabulary", etc. Every teacher gets the 5 canonical categories seeded on
// first use (mirrors FocusTag's own pack-seeding), but — unlike the pack tags
// themselves — a category is NOT pinned to a fixed enum: a teacher can rename,
// reorder, add, or delete any category, built-in or custom, the same way she
// already can with tags. A category can only be archived once it has zero
// active tags (enforced in @/lib/focus-tags, `onDelete: Restrict` below is the
// DB-level backstop) — there is deliberately no cascade-archive-the-tags-too
// path, so deleting a category is always a conscious, visible decision about
// where those tags go.
model FocusTagCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  code      String // stable key, unique per teacher — one of the 5 built-ins or "custom:<slug>-<rand>"
  label     String // display, e.g. "Grammar" / "Gramática" — freely renameable
  position  Int // ordering within the picker
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  focusTags FocusTag[]

  @@unique([teacherId, code])
  @@index([teacherId, position])
  @@map("focus_tag_categories")
}

model FocusTag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  code       String // stable key, unique per teacher, e.g. "past_tense"
  label      String // display, e.g. "Past tense" / "Pretérito"
  categoryId String   @map("category_id") @db.Uuid
  position   Int // ordering within the picker
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher          Teacher                   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  category         FocusTagCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  libraryMaterials LibraryMaterialFocusTag[]

  @@unique([teacherId, code])
  @@index([teacherId, position])
  @@index([categoryId])
  @@map("focus_tags")
}

// A teacher's material — the single entity for anything she creates to teach
// with: a file, a link, or AI-drafted/typed Markdown content, taggable with
// her category/format/theme taxonomy. It plays one of two roles, told apart
// by `bookingId`:
//   - bookingId IS NULL — a reusable LIBRARY item: level-gated, browsable,
//     assignable to any student or class (via StudentLibraryItem /
//     BookingLibraryMaterial below). Files live under
//     `${teacherId}/library/...` so the 60-day per-class purge never touches
//     them.
//   - bookingId IS SET — a PRIVATE item that exists only for that one class:
//     the direct replacement for the old ClassMaterial (a file/link sent on a
//     schedule) and ClassContent (AI/typed lesson content, always visible,
//     one per booking in practice though not DB-enforced). Never appears in
//     the level-gated browse shelf or any other class.
// This merge (docs/features/library-materials.md, D-69) intentionally keeps
// the Prisma/table name `LibraryMaterial` — renaming it would ripple through
// every consumer (mobile wire types, storage paths, the focus-tag join table
// name) for no functional gain; `bookingId` is the only thing that changes
// what a row *means*.
model LibraryMaterial {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId     String              @map("teacher_id") @db.Uuid
  // NULL for a private, booking-scoped item — level is a library-browse
  // concept and doesn't apply to something only one class can ever see.
  levelId       String?             @map("level_id") @db.Uuid
  // Set only on a private, booking-scoped item (see model doc above).
  bookingId     String?             @map("booking_id") @db.Uuid
  visibility    LibraryVisibility   @default(at_or_below)
  // Optional grouping/order within a level — her notebook is sequential.
  unit          String?
  position      Int                 @default(0) // order within (level, unit)
  storagePath   String?             @map("storage_path") // reuses class-materials bucket
  linkUrl       String?             @map("link_url")
  // Reusable native content (docs/features/classes-lesson-content.md,
  // D-20, Layer 4; generalized from ClassContent by D-69). A material is one
  // of three kinds: a file (storagePath), an external link (linkUrl), or
  // native Markdown content (`body`) — rendered natively, never as raw HTML.
  // `contentSource` records provenance (manual vs ai).
  body          String?             @map("body") // Markdown source when this item is native content
  contentSource ClassContentSource? @map("content_source")
  label         String?
  // NULL = always visible immediately once present, never pushed — the old
  // ClassContent behavior, and the default for a generated lesson write-up.
  // Set = pushed via WhatsApp/email at that moment (old ClassMaterial
  // behavior) — only meaningful (and only ever set) on a booking-scoped item;
  // a reusable library item is pulled by the student, never pushed.
  sendTiming    MaterialSendTiming? @map("send_timing")
  archived      Boolean             @default(false)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz

  teacher             Teacher                   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  level               Level?                    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  booking             Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignments         StudentLibraryItem[]
  focusTags           LibraryMaterialFocusTag[]
  bookingAttachments  BookingLibraryMaterial[]
  classUses           ClassMaterialUse[]
  revisions           MaterialRevision[]
  podcast             MaterialPodcast?
  // Homework Assignments drafted from this material (Assignment.sourceMaterialId)
  // — named to avoid colliding with `assignments` above, the unrelated
  // "assign this library item to a student" (notebook) feature.
  homeworkAssignments Assignment[]

  @@index([teacherId, levelId, position])
  @@index([teacherId, bookingId])
  // Paginated library list (web offset + mobile cursor): the equality prefix
  // (teacherId, bookingId, archived) seeks, then createdAt/id range-scans in
  // the default "recently added" order and backs the keyset cursor. Name pinned
  // (the default would exceed Postgres's 63-char identifier limit).
  @@index([teacherId, bookingId, archived, createdAt, id], map: "lib_mat_teacher_booking_archived_created_idx")
  // Backs the web "Name A–Z" sort's ordered scan for the same scoped prefix.
  @@index([teacherId, bookingId, archived, label], map: "lib_mat_teacher_booking_archived_label_idx")
  @@map("library_materials")
}

// Version history for a material's `body` (generalized from the old
// ClassContentRevision by D-69 — see docs/features/library-materials.md). A
// row is written for the PREVIOUS body just before it's overwritten by a save
// (including a "restore," which is itself a save, so what it replaces is
// snapshotted too — restores stay reversible in both directions). Applies to
// ANY material with a body, private or reusable: a teacher iterating on a
// reusable library item's AI-drafted text gets the same undo a class's
// content always had. Capped per material (CLASS_CONTENT_MAX_REVISIONS) so
// it can't grow unbounded.
model MaterialRevision {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId String             @map("material_id") @db.Uuid
  teacherId  String             @map("teacher_id") @db.Uuid
  body       String
  source     ClassContentSource
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz

  material            LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  // Homework Assignments pinned to this exact revision (Assignment.sourceMaterialRevisionId).
  homeworkAssignments Assignment[]

  @@index([materialId, createdAt])
  @@index([teacherId])
  @@map("material_revisions")
}

// A material's generated podcast — a spoken, single-narrator audio rendition of
// its `body` (Claude writes the script, ElevenLabs renders the mp3). Its own
// entity, 1:1 with the material (UNIQUE materialId), mirroring how every other
// generated/derived artifact here (MaterialRevision, ClassContentGeneration,
// LessonSummary, CallRecording) is a separate table rather than columns bolted
// onto the hot, dual-scope LibraryMaterial row. One podcast per material:
// regenerating reuses this row (flip `status` back to `pending`); deleting the
// material cascades it (the audio object in R2 is deleted best-effort). Gating
// is the shared class_content Pro-cap — a success burns one ClassContentGeneration
// row, same quota pool as text generation. `storagePath` keys the object in the
// material-podcasts R2 bucket; playback is a short-lived signed URL, never public.
model MaterialPodcast {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId  String        @unique @map("material_id") @db.Uuid
  teacherId   String        @map("teacher_id") @db.Uuid // denormalized for tenant-scoped reads
  status      PodcastStatus
  storagePath String?       @map("storage_path") // key in the material-podcasts bucket
  script      String? // the spoken monologue that was synthesized
  durationSec Int?          @map("duration_sec") // estimated from the script (~150 wpm)
  voice       String? // the ElevenLabs voice id used
  error       String? // last failure reason, for the UI + debugging
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  generatedAt DateTime?     @map("generated_at") @db.Timestamptz // set when status → ready

  material LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  teacher  Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("material_podcasts")
}

// Tags a library material with the teacher's existing category/focus taxonomy
// (categories, formats, themes, …) — gap G1. Reuses FocusTag/FocusTagCategory
// as-is; a material is just a second thing (alongside a class) that taxonomy
// can attach to. No new taxonomy system, no new settings screen — a tag
// attached here is renamed/reordered/archived from the exact same
// /settings/focus-tags editor that already manages class-content focus tags.
model LibraryMaterialFocusTag {
  libraryMaterialId String @map("library_material_id") @db.Uuid
  focusTagId        String @map("focus_tag_id") @db.Uuid

  material LibraryMaterial @relation(fields: [libraryMaterialId], references: [id], onDelete: Cascade)
  focusTag FocusTag        @relation(fields: [focusTagId], references: [id], onDelete: Cascade)

  @@id([libraryMaterialId, focusTagId])
  @@index([focusTagId])
  @@map("library_material_focus_tags")
}

// Attaches an existing library item onto one reserved class (gap G3) — the
// counterpart to ClassMaterial's fresh-upload path, for the "assign from what
// I already built" path instead. Reuses the exact same send-timing vocabulary
// and reminder-tick delivery pipeline as ClassMaterial (see
// lib/notifications/materials.ts); attaching after the chosen moment has
// already elapsed (e.g. "confirmation") enqueues the send immediately, same
// as a fresh upload (lib/materials/timing.ts).
model BookingLibraryMaterial {
  bookingId         String             @map("booking_id") @db.Uuid
  libraryMaterialId String             @map("library_material_id") @db.Uuid
  sendTiming        MaterialSendTiming @map("send_timing")
  attachedAt        DateTime           @default(now()) @map("attached_at") @db.Timestamptz

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  material LibraryMaterial @relation(fields: [libraryMaterialId], references: [id], onDelete: Cascade)

  @@id([bookingId, libraryMaterialId])
  @@index([libraryMaterialId])
  @@map("booking_library_materials")
}

// A teacher-private record that a material was actually OPENED during a class
// — the "what did we use last time?" ledger.
//
// WHY THIS IS NOT A FLAG ON BookingLibraryMaterial. That table is a
// student-facing edge: a row there means the item is attached to the class,
// carries a `sendTiming`, and rides the WhatsApp/email delivery pipeline
// (app/actions/booking-library-materials.ts). Recording "I pulled this up on
// the call" through it would push a material to the student every time the
// teacher so much as previewed one for herself. The two facts are genuinely
// different — attached is a promise to the student, used is a fact about the
// lesson — so they get different rows. Nothing here is ever shown to the
// student, and nothing here sends anything.
//
// Grain is one row per (booking, material), not one per open: the question
// this answers is "was this used in that class", so a re-open updates the
// existing row rather than growing an unbounded log. `openedAt` is therefore
// FIRST use in that class; `openedFor` widens to "both" if a later open in the
// same class had a different audience (recordClassMaterialUse).
//
// The material may be booking-scoped (LibraryMaterial.bookingId set) or a
// reusable library item — both are openable from the in-call materials sheet,
// and a library item opened mid-call and never attached exists in NO other
// table, which is exactly the gap this closes.
model ClassMaterialUse {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid // denormalized for tenant-scoped reads, like StudentLibraryItem
  bookingId  String   @map("booking_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  openedAt   DateTime @default(now()) @map("opened_at") @db.Timestamptz
  // Who the teacher opened it for: "teacher" (her own screen), "student"
  // (pushed to the student's in-call viewer), or "both". A String rather than
  // an enum for the same reason as StudentLibraryItem.completedBy — the set is
  // presentation-level and may grow without earning a migration.
  openedFor  String   @default("teacher") @map("opened_for")

  teacher  Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  material LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([bookingId, materialId])
  @@index([materialId])
  @@index([teacherId, openedAt])
  @@map("class_material_uses")
}

// Per-student assignment + completion — the digital notebook. A teacher
// assigns a library item to one of her students and marks it covered.
// Existence of a row = "assigned"; completedAt set = "covered". Assigned items
// are visible to the student REGARDLESS of level (the teacher is explicitly
// accompanying them) — the only sanctioned path above the browse ceiling.
model StudentLibraryItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId         String    @map("teacher_id") @db.Uuid // denormalized for tenant-scoped reads
  studentId         String    @map("student_id") @db.Uuid
  libraryMaterialId String    @map("library_material_id") @db.Uuid
  assignedAt        DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz // null = not yet covered
  // Who flipped completedAt — teacher-only in v1; the column lets us open
  // self-marking to students later without a migration.
  completedBy       String?   @map("completed_by") // "teacher" | "student"
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  teacher  Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material LibraryMaterial @relation(fields: [libraryMaterialId], references: [id], onDelete: Cascade)

  @@unique([studentId, libraryMaterialId]) // one assignment per (student, item)
  @@index([teacherId, studentId])
  @@map("student_library_items")
}

// Teacher-private notes about a student (e.g. "focus on the subjunctive next
// class"). Per (teacher, student) and never shown to the student: there is no
// student-side RLS policy and the notes are deliberately excluded from the
// student data export (see export-data.ts) — mirroring the teacher-private
// `teacher_students.custom_price_note`. A free-form journal (many rows per
// pairing, newest-first) rather than a single blob, so history is preserved.
// teacher_id is denormalized for tenant-scoped reads/RLS, like the notebook.
// Unlike the teacher overrides, note edits are NOT written to the `overrides`
// table — those rows surface to the student, which would leak the notes.
model StudentNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId, studentId, createdAt])
  @@map("student_notes")
}

// --- Payments ---

// One set of payee instructions a teacher publishes for the manual-transfer
// rail (D-113). Wise was a `PaymentProvider` value and 7 columns on
// `teachers`; it is one row here, and SPEI is a second. What the rail
// actually does — render payee instructions plus a unique reference, let the
// student self-attest, let the teacher confirm, then run the SAME
// `advancePayment` reducer Stripe runs — was never Wise-shaped.
//
// Kind-specific fields are typed nullable columns guarded by CHECK
// constraints rather than a JSON blob: this is a closed union of known kinds,
// and the constraints are what stop a malformed payee detail reaching a page
// a student pays from.
//
// One instrument per kind per teacher (`@@unique([teacherId, kind])`). A
// teacher has one Wise account and one CLABE; making that the DB's opinion
// keeps the settings UI a form per kind instead of a list builder. Wanting
// two CLABEs later is a real decision, not something to leave the door open
// to by accident.
model TeacherPayoutInstrument {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId     String               @map("teacher_id") @db.Uuid
  kind          PayoutInstrumentKind
  // The gate, per instrument. A teacher can pause an instrument at checkout
  // without losing the details on file — the same affordance
  // `wise_payments_enabled` used to give, now scoped to one instrument
  // instead of the whole rail.
  enabled       Boolean              @default(false)
  // Payee display name, shown to the student on the instructions page so the
  // name they see in their banking app matches. Kind-agnostic: both a Wise
  // recipient and a CLABE holder have one.
  accountHolder String?              @map("account_holder")

  // --- kind = wise -------------------------------------------------------
  // Wisetag/handle (e.g. "anal3829"), used to build wise.com/pay/me/<handle>.
  // Required when an instrument of this kind is enabled.
  wiseHandle       String? @map("wise_handle")
  // Optional payee email — some Wise users prefer searching by email.
  wiseEmail        String? @map("wise_email")
  // Per-instrument Wise Platform API credentials for automated
  // reconciliation (poll-wise-statements cron). These live on the INSTRUMENT
  // because auto-reconcile is an instrument capability, not a teacher one —
  // which is exactly what makes it honest that SPEI has none and never will
  // (Mexican retail banks expose no per-teacher statement API, so a SPEI
  // payment is 100% teacher-confirmed, permanently).
  //   * wiseApiProfileId — numeric Wise profile id (non-secret, plaintext).
  //   * wiseApiTokenEnc  — Wise API token, field-encrypted (v1:… ) when
  //     FIELD_ENCRYPTION_KEY is set, plaintext fallback otherwise.
  //   * wiseApiKeyEnc    — PEM RSA private key for SCA statement signing,
  //     field-encrypted the same way.
  wiseApiProfileId String? @map("wise_api_profile_id")
  wiseApiTokenEnc  String? @map("wise_api_token_enc")
  wiseApiKeyEnc    String? @map("wise_api_key_enc")

  // D-145 dropped `scheme_id`, `country` and `details` with the
  // `bank_account` kind. They held a per-country account format from a
  // 15-scheme registry (D-124) — three columns instead of one per country,
  // which is what made "a teacher anywhere" a registry row rather than a
  // migration. Good design for the problem as it stood; the problem changed
  // when D-143 made Stripe present her country's own bank transfer with
  // automatic reconciliation, which a self-attested one never could.
  //
  // Do NOT reintroduce them as a free-form payee blob if a second kind
  // returns. Every payee value a student pays against must be
  // machine-checkable — that rule outlived the registry it was written for.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([teacherId, kind])
  @@index([teacherId])
  @@map("teacher_payout_instruments")
}

model Payment {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId               String          @map("package_id") @db.Uuid
  amountMinorUnits          Int             @map("amount_minor_units")
  currency                String          @default("MXN")
  status                  PaymentStatus   @default(pending)
  provider                PaymentProvider @default(stripe)
  // Stripe PaymentIntent id (`pi_xxx`) on the platform. Set on the first
  // `checkout.session.completed`.
  providerPaymentId       String?         @unique @map("provider_payment_id")
  // UUID we generate per checkout intent and pass to Stripe as
  // `metadata.external_reference` (and as the Checkout Session
  // `client_reference_id`). Used for idempotent webhook lookup since the
  // PaymentIntent id isn't known until after the session resolves.
  externalReference       String          @unique @default(dbgenerated("gen_random_uuid()")) @map("external_reference") @db.Uuid
  // Stripe Checkout Session id (`cs_xxx`). Recorded so we can hydrate the
  // post-checkout success page if the buyer-side query hasn't reached us
  // through the webhook yet.
  stripeCheckoutSessionId String?         @map("stripe_checkout_session_id")
  rail                    PaymentRail     @default(unknown)
  paidAt                  DateTime?       @map("paid_at") @db.Timestamptz
  refundedAt              DateTime?       @map("refunded_at") @db.Timestamptz
  // Stripe Refund id (`re_xxx`).
  refundProviderId        String?         @map("refund_provider_id")
  // No transfer / commission / teacher-net columns here (D-143). All three
  // described money the PLATFORM moved: the Transfer that forwarded the settled
  // net, the cut withheld from it, and what was left for the teacher. Direct
  // charges settle on her own connected account, so the platform never holds,
  // withholds or forwards any of it — `amountMinorUnits` is simply what the
  // student paid her.
  // Manual-transfer fields (instrument-neutral as of D-113 — these were
  // `wise_*` when Wise was the provider rather than one instrument).
  //
  // `instrumentId` records WHICH payee instructions this student was
  // actually shown. It is the row that makes the rail generic: without it,
  // a payment's instructions are only recoverable by re-reading whatever the
  // teacher has on file today, which is not what the student saw. Required
  // for `manual_transfer` and null for Stripe, enforced by CHECK.
  instrumentId            String?         @map("instrument_id") @db.Uuid
  // The human-friendly token the student is asked to paste into their
  // transfer's reference/concepto field (e.g. "AGP-1A2B3C4D"). Unique so
  // reconciliation can match unambiguously even when amounts collide. It is
  // the ONLY matching key on the SPEI instrument — SPEI's concepto field is
  // free text that senders truncate, mistype, or leave blank, and unlike
  // Wise there is no statement to match against afterward.
  paymentReference        String?         @unique @map("payment_reference")
  // The teacher's user id when the payment was marked paid manually. The
  // automated reconciler leaves it null and stamps `autoMatchedAt` instead,
  // so the two confirmation sources stay distinguishable for audit.
  confirmedBy             String?         @map("confirmed_by") @db.Uuid
  confirmedAt             DateTime?       @map("confirmed_at") @db.Timestamptz
  // Set by the automated reconciler when a matching incoming credit is found
  // on the instrument's balance statement (reference + amount match). Only
  // the Wise instrument can ever set this — SPEI has no statement API, so
  // every SPEI payment is teacher-confirmed forever. When set, `confirmedBy`
  // is null and `confirmedAt` still records the flip-paid instant.
  autoMatchedAt           DateTime?       @map("auto_matched_at") @db.Timestamptz
  // Set when the student clicks "Ya envié el pago" on the transfer
  // instructions page. The button is idempotent (a re-click is a no-op) and
  // only emits the teacher-side `payment_marked_sent_teacher` notification
  // the first time. Stays null for Stripe payments.
  studentMarkedSentAt     DateTime?       @map("student_marked_sent_at") @db.Timestamptz
  // PostHog browser session id captured at checkout-intent creation,
  // forwarded by the public booking funnel. Lets payment_received
  // (fired later from a webhook with no user session) link back to the
  // session recording around the original purchase click. Null when the
  // student blocks posthog-js or session sampling skipped them.
  posthogSessionId        String?         @map("posthog_session_id")
  // VAT/GST readiness (global-launch item 7). The buyer's billing country
  // (ISO-3166-1 alpha-2) and full address, captured on the Stripe hosted
  // checkout page (`billing_address_collection: required`) and read back off
  // `customer_details` when the session completes. Capture-only: no tax is
  // computed or collected yet — this exists so Stripe Tax (automatic_tax) can
  // be switched on later (see stripeTaxEnabled()) with NO retroactive backfill.
  // Null until the session completes (and for pre-migration rows / manual transfers).
  billingCountry          String?         @map("billing_country")
  billingAddressJson      Json?           @map("billing_address_json")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz

  package            Package                  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a teacher's instrument must never delete
  // the payments taken through it. The settings UI disables an instrument
  // rather than deleting one that has payments.
  instrument         TeacherPayoutInstrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  disputes           Dispute[]
  discountRedemption DiscountRedemption?
  // The referral this payment earned, if any (slice 2b). One-to-one via
  // Referral.paymentId (@unique).
  referral           Referral?

  @@index([packageId])
  @@index([status])
  // Admin/finance cross-tenant queries (export + /admin/payments) filter by
  // status (+ an optional createdAt range) and sort by createdAt — the
  // single-column @@index([status]) above doesn't cover the sort, so those
  // scans degrade as the platform-wide payments table grows.
  @@index([status, createdAt])
  // Admin overview's "recent payments" widget filters status=paid and sorts
  // by paidAt — a distinct sort column from createdAt, needs its own index.
  @@index([status, paidAt])
  // FK lookups for the Restrict on delete, and "pending payments on this
  // instrument" for the reconciler.
  @@index([instrumentId])
  @@map("payments")
}

// --- Overrides (audit) ---

// Append-only at the DATABASE level: two BEFORE triggers in the invariants
// migration raise on any UPDATE or DELETE. The claim this table makes is that
// nobody rewrote it, which the application cannot make about itself — so it is
// enforced somewhere the application's own credential cannot reach around.
model Override {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // NULL for a platform-scoped action with no single teacher (e.g. a
  // superadmin impersonating a standalone student). Nullable so those rows
  // are still recorded instead of silently skipped. See lib/audit.ts.
  teacherId    String?            @map("teacher_id") @db.Uuid
  targetType   OverrideTargetType @map("target_type")
  targetId     String             @map("target_id") @db.Uuid
  action       String
  reason       String
  beforeJson   Json?              @map("before_json")
  afterJson    Json?              @map("after_json")
  // NULL when the affected teacher applied the override themselves
  // (e.g. via the one-tap override actions). Set when a platform admin
  // acted from /admin — the FK survives admin deletions as NULL.
  actorAdminId String?            @map("actor_admin_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  teacher    Teacher?   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([teacherId, targetType, targetId])
  @@index([actorAdminId])
  // /admin/audit lists every override platform-wide, unfiltered, sorted by
  // createdAt desc — no existing index covers that scan.
  @@index([createdAt])
  @@map("overrides")
}

enum ContactChangeActorType {
  student
  teacher
  admin
}

// Audit trail for student contact-detail edits (name / email / phone
// number / timezone): one row per save, before/after JSON limited to the
// fields that changed. Distinct from Override — that table records
// business-rule overrides and always belongs to a teacher, while contact
// edits are usually the student's own self-service saves with no acting
// teacher. Rows hold old emails/numbers (personal data), so student
// anonymization deletes them — see src/lib/account-deletion/anonymize.ts.
model StudentContactChange {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String                 @map("student_id") @db.Uuid
  actorType      ContactChangeActorType @map("actor_type")
  // Set when actorType=teacher; the FK survives teacher deletion as NULL.
  actorTeacherId String?                @map("actor_teacher_id") @db.Uuid
  // Set when actorType=admin (support-initiated email change). NULL for
  // bootstrap superadmins (no admin_users row) — same convention as
  // Override.actorAdminId.
  actorAdminId   String?                @map("actor_admin_id") @db.Uuid
  beforeJson     Json                   @map("before_json")
  afterJson      Json                   @map("after_json")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz

  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actorTeacher Teacher?   @relation(fields: [actorTeacherId], references: [id], onDelete: SetNull)
  actorAdmin   AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("student_contact_changes")
}

// --- Notifications ---

model Notification {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId         String                    @map("teacher_id") @db.Uuid
  recipientType     NotificationRecipientType @map("recipient_type")
  recipientId       String                    @map("recipient_id") @db.Uuid
  bookingId         String?                   @map("booking_id") @db.Uuid
  paymentId         String?                   @map("payment_id") @db.Uuid
  // The actual channel used at dispatch time. Producers leave this as
  // 'push' (the top of the cascade). At dispatch the resolver picks the
  // preferred channel — push when the recipient has a registered
  // device_token; email otherwise. The dispatcher rewrites the column to
  // whichever channel actually delivered the message.
  channel           NotificationChannel
  templateName      String                    @map("template_name")
  // Producer-supplied template variables that the dispatcher can't re-derive
  // from the schema alone (e.g., minted magic-link URL, materials download
  // path, missing-amount minor units). Shape varies by template — see the
  // `enqueue.ts` producers for the contract per template.
  metadata          Json?
  // Language Meta sent against. 'es_MX' or 'en'. Null until dispatched.
  languageCode      String?                   @map("language_code")
  status            NotificationStatus        @default(queued)
  error             String?
  // Channel-dependent: Resend message id (email) or Expo push ticket id
  // (push). Set on successful send. Push delivery walks Expo's receipts
  // endpoint via the poll-push-receipts Inngest cron.
  providerMessageId String?                   @unique @map("provider_message_id")
  sentAt            DateTime?                 @map("sent_at") @db.Timestamptz
  deliveredAt       DateTime?                 @map("delivered_at") @db.Timestamptz
  failedAt          DateTime?                 @map("failed_at") @db.Timestamptz
  // In-app inbox read state. Independent of delivery (status/sentAt): a row is
  // an inbox item the moment it's created, regardless of whether the external
  // channel — email/push — ever reached the recipient. Null = unread.
  // The recipient marks it read by opening it in the inbox; it is never set by
  // the dispatcher. See src/lib/notifications/inbox.ts.
  readAt            DateTime?                 @map("read_at") @db.Timestamptz
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  @@index([teacherId, createdAt])
  @@index([status])
  @@index([bookingId])
  // Inbox listing + unread-count queries scope by (recipientType, recipientId)
  // and order by createdAt; recipientId differs from teacherId for student
  // recipients, so the existing teacherId index doesn't cover them.
  @@index([recipientType, recipientId, createdAt])
  // The subscription sweep and other dedup checks look up rows by
  // (teacherId, templateName) — e.g. "has this teacher already had a
  // trial-ending notice?". Without this the lookup was a scan of the
  // teacher's whole notification history.
  @@index([teacherId, templateName])
  // /admin/notifications filters platform-wide by status (+ optional
  // channel/template search) and sorts by createdAt — the plain
  // @@index([status]) above can't serve the sort.
  @@index([status, createdAt])
  @@map("notifications")
}

// Expo push tokens — one row per (recipient, device). Soft-revoked via
// `revoked_at` so we keep history when a token goes stale. Fan-out
// dispatch reads all rows where `revoked_at IS NULL`. Not tenant-scoped:
// teachers and students each own their own rows keyed by recipient_type.
// Browser Web Push subscriptions — the `push` notification CHANNEL's only
// transport. It had a sibling, `device_tokens`, holding the Expo tokens of the
// client that has been deleted; that transport was removed and this dropped
// the table.
//
// Identity is the endpoint URL the browser's push service mints — unique, and
// what the recipient re-sends on every subscribe, so it doubles as the upsert
// key exactly like expo_push_token does. `p256dh`/`auth` are the client's
// public encryption keys; payloads are encrypted to them and the push service
// never sees plaintext.
//
// Soft-revoked via `revoked_at`: a 404/410 from the push service means the
// subscription is permanently gone (permission revoked, site data cleared) and
// the dispatcher revokes it in place. Not tenant-scoped —
// teachers and students each own their rows keyed by recipient_type.
model WebPushSubscription {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientType NotificationRecipientType @map("recipient_type")
  recipientId   String                    @map("recipient_id") @db.Uuid
  endpoint      String                    @unique
  p256dh        String
  auth          String
  // Free-text UA string captured at subscribe time, so a recipient with several
  // browsers can tell them apart when we surface a device list later. Never
  // parsed for behaviour.
  userAgent     String?                   @map("user_agent")
  lastSeenAt    DateTime                  @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipientType, recipientId], map: "web_push_subscriptions_recipient_idx")
  @@map("web_push_subscriptions")
}

// Idempotency log for inbound provider webhooks. See
// docs/security.md. Every webhook handler records the
// (provider, event_id) tuple before mutating state; a second arrival
// with the same key short-circuits. Stripe de-duplicates on its end too
// but Meta replays freely, so we don't trust the provider alone. NOT
// tenant-scoped — webhook arrivals aren't bound to a teacher until the
// handler resolves one. Service-role only.
model WebhookEvent {
  // Surrogate primary key — keeps the index small even with the
  // composite uniqueness below.
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    WebhookProvider
  // The provider's event id. `evt_xxx` for Stripe, the Inngest event id.
  eventId     String          @map("event_id")
  // Optional human label — `payment_intent.succeeded`, `delivered`, ...
  eventType   String?         @map("event_type")
  receivedAt  DateTime        @default(now()) @map("received_at") @db.Timestamptz
  // When the handler for this event FULLY completed (D-79). NULL = claimed but
  // not yet done (in flight, or a dead claim to be reclaimed on retry). Only a
  // non-null value marks a genuine duplicate that can be ack'd without work.
  processedAt DateTime?       @map("processed_at") @db.Timestamptz

  @@unique([provider, eventId], map: "webhook_events_provider_event_unique")
  @@index([receivedAt], map: "webhook_events_received_at_idx")
  @@map("webhook_events")
}

// Stripe `charge.dispute.*` events. See docs/security.md. We
// keep the row regardless of whether we identify the underlying Payment
// — disputes can land on charges we didn't expect (test mode bleed,
// out-of-band refunds). Notifications to the team are emitted from the
// webhook handler.
model Dispute {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stripe dispute id (`dp_xxx`). Unique so a replay updates the same row.
  stripeDisputeId       String        @unique @map("stripe_dispute_id")
  // Stripe Charge id (`ch_xxx`) the dispute lives on.
  stripeChargeId        String        @map("stripe_charge_id")
  // PaymentIntent that owns the charge, if Stripe surfaces it. Null when
  // a teacher has a raw charge from outside our flow.
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  // Our local Payment row, when resolved. Null = unmatched dispute (rare;
  // surface to ops via the audit log + email).
  paymentId             String?       @map("payment_id") @db.Uuid
  // Tenant scope; null when paymentId is null.
  teacherId             String?       @map("teacher_id") @db.Uuid
  amountMinorUnits        Int           @map("amount_minor_units")
  currency              String
  reason                String
  status                DisputeStatus
  // Stripe's `evidence_details.due_by` — past it, Stripe sides with the
  // cardholder by default. Null on warnings.
  evidenceDueBy         DateTime?     @map("evidence_due_by") @db.Timestamptz
  // Whether `is_charge_refundable=false` (i.e. the dispute is finalised).
  isFinal               Boolean       @default(false) @map("is_final")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([teacherId, createdAt], map: "disputes_teacher_created_idx")
  @@index([status], map: "disputes_status_idx")
  // /admin/disputes always sorts open-before-resolved first (isFinal asc)
  // then by the chosen column; createdAt is the default secondary sort and
  // neither existing index covers (isFinal, createdAt) together.
  @@index([isFinal, createdAt], map: "disputes_is_final_created_idx")
  @@map("disputes")
}

// Self-serve account deletion requests. See docs/security.md.
// On request we write a row in `pending`; an Inngest job picks it up
// after the grace window and anonymizes the subject. The user can
// cancel from the same UI before the window expires.
model AccountDeletionRequest {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType  AccountDeletionSubjectType @map("subject_type")
  // For teachers: Teacher.id. For students: Student.id. We store the
  // type so the worker knows which table to anonymize.
  subjectId    String                     @map("subject_id") @db.Uuid
  // Cached at request time so we have something to send to if the user
  // changes their mind and the original row is already anonymized by a
  // separate path (rare; tax-record retention may keep the row).
  email        String
  status       AccountDeletionStatus      @default(pending)
  // When the Inngest job becomes eligible to anonymize. Today: now + 30
  // days. Stored so future policy changes (longer grace, shorter for a
  // specific subject under regulator instruction) don't require code.
  scheduledFor DateTime                   @map("scheduled_for") @db.Timestamptz
  cancelledAt  DateTime?                  @map("cancelled_at") @db.Timestamptz
  anonymizedAt DateTime?                  @map("anonymized_at") @db.Timestamptz
  // Free-form audit. Useful when the request came in by email and a
  // superuser created it manually.
  reason       String?
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  // Partial unique index `account_deletion_one_pending_per_subject`
  // (status='pending', see migration SQL) prevents a second request
  // while one is open. Cancelled / anonymized rows accumulate as audit.
  @@index([subjectType, subjectId], map: "account_deletion_subject_idx")
  @@index([status, scheduledFor], map: "account_deletion_schedule_idx")
  @@map("account_deletion_requests")
}

// Closed-beta allow-list entries managed via the super-user admin panel.
// Merged at runtime with `BUILTIN_ALLOWLIST` and the `ALPHA_TEACHER_ALLOWLIST`
// env var (see `src/lib/env.ts:effectiveAllowlist`). NOT tenant-scoped —
// platform-wide. Service-role only (no RLS read/write for anon).
model AlphaAllowlistEntry {
  email     String   @id
  addedBy   String?  @map("added_by")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("alpha_allowlist_entries")
}

// Platform staff. NOT tenant-scoped. Service-role only (RLS enabled with no
// `authenticated` policies — mirrors `alpha_allowlist_entries`). The
// `SUPERUSER_EMAILS` env var stays as a bootstrap fallback when the table is
// empty (see `src/lib/admin.ts`). Once at least one row exists, this table is
// the source of truth.
model AdminUser {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @unique
  role        AdminRole
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdById String?   @map("created_by_id") @db.Uuid
  disabledAt  DateTime? @map("disabled_at") @db.Timestamptz

  createdBy      AdminUser?             @relation("AdminCreator", fields: [createdById], references: [id], onDelete: SetNull)
  invited        AdminUser[]            @relation("AdminCreator")
  overrides      Override[]
  contactChanges StudentContactChange[]

  @@map("admin_users")
}

// One row per environment tracking in-progress /admin/uat checklist state
// (D-55). Ephemeral run tracker, not an audit record — the real audit trail
// is the `Override` rows the probe/reseed/PostHog-check/Stripe-check actions
// write via writeOverride(). If the runbook's checklist items are reordered,
// `checkedItems` (keyed by document-order index) just resets harmlessly.
model UatChecklistState {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetEnv        String   @unique @map("target_env")
  checkedItems     Json     @map("checked_items")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid

  @@map("uat_checklist_state")
}

// One row per teacher capturing their current plan + billing lifecycle. The
// platform-account Stripe Billing objects (Customer, Subscription) are
// referenced by id; amounts are never re-charged from here (Products/Prices
// are created out-of-band and referenced by env Price IDs). See
// src/lib/subscriptions/* and docs/features/subscriptions.md.
model TeacherSubscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId            String             @unique @map("teacher_id") @db.Uuid
  plan                 SubscriptionPlan   @default(free)
  status               SubscriptionStatus @default(trialing)
  // The price the teacher is locked to (minor units, in `currency` below). For
  // `founding` this is FOUNDING price and never auto-increases to monthly.
  // Null for free.
  lockedPriceMinorUnits  Int?               @map("locked_price_minor_units")
  // The platform's canonical billing currency is GBP as of D-99 (was MXN) —
  // this default only applies to a row created without an explicit currency;
  // every real activation path always passes one explicitly (see
  // billing-webhook-handler.ts). A pre-D-99 row's stored "MXN" is untouched by
  // this default change — existing values are never reinterpreted.
  currency             String             @default("GBP")
  // Platform-account Stripe Billing identifiers (NOT Connect).
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  // 30-day Pro trial end; fall to free after this if not subscribed.
  trialEndsAt          DateTime?          @map("trial_ends_at") @db.Timestamptz
  // Current paid period end (from Stripe) — also the past_due grace anchor.
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz
  // Stripe's `cancel_at_period_end`: the teacher has cancelled in the Customer
  // Portal but is paid through `currentPeriodEnd` and keeps Pro until then. It
  // is NOT `canceledAt` — that is stamped when the subscription actually ends
  // and the row drops to free. Both can be false/null on a live subscription,
  // and this one flips back to false if she resumes, so it has to be written on
  // every activation rather than only when it becomes true.
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz
  // Internal flag = full Pro, never billed (e.g. a comped early account).
  // Independent of `status`.
  comped               Boolean            @default(false)
  // VAT/GST readiness (global-launch item 7). The teacher's billing country
  // (ISO-3166-1 alpha-2) + full address, captured on the subscription Checkout
  // page (`billing_address_collection: required` + `customer_update[address]`)
  // and read back off the platform Customer when the subscription activates.
  // Capture-only — no tax computed yet; lets Stripe Tax be enabled later (see
  // stripeTaxEnabled()) with no backfill. Null until the first activation.
  billingCountry       String?            @map("billing_country")
  billingAddressJson   Json?              @map("billing_address_json")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@map("teacher_subscriptions")
}

// One row per billing cycle. Rail-agnostic via `provider` so a manual
// subscription rail can land without a schema change. `netMinorUnits`
// (amount − fee) is persisted explicitly — it's the commission base for the
// ambassador report.
model SubscriptionInvoice {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId        String                      @map("teacher_id") @db.Uuid
  periodStart      DateTime                    @map("period_start") @db.Timestamptz
  periodEnd        DateTime                    @map("period_end") @db.Timestamptz
  amountMinorUnits   Int                         @map("amount_minor_units")
  // The platform's Stripe cost on this charge (processing fee). Read back from
  // Stripe's balance transaction when available; 0 for manual.
  feeMinorUnits      Int                         @default(0) @map("fee_minor_units")
  // amount − fee. The commission base. Persisted, not derived, so a later fee
  // re-read can't silently move historical commission totals.
  netMinorUnits      Int                         @map("net_minor_units")
  // Currency of amount/fee/net, recorded for provenance so the subscription
  // rail's denomination is never implicit. Canonical currency is GBP as of
  // D-99 (was MXN); a pre-D-99 invoice's stored "MXN" is untouched.
  currency         String                      @default("GBP")
  status           SubscriptionInvoiceStatus   @default(open)
  // Own enum since D-113 — see SubscriptionPaymentProvider. Sharing
  // `PaymentProvider` with the teacher-payout rail meant a rename on one
  // concern silently renamed the other.
  provider         SubscriptionPaymentProvider @default(stripe)
  stripeInvoiceId  String?                     @unique @map("stripe_invoice_id")
  // Reference for a `manual` invoice — the transfer the admin recorded.
  manualPaymentRef String?                     @map("manual_payment_ref")
  paidAt           DateTime?                   @map("paid_at") @db.Timestamptz
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, periodStart])
  @@index([status])
  @@map("subscription_invoices")
}

// One manually-entered line item per vendor per calendar month — a platform
// running cost (hosting, third-party APIs, dev tooling, Claude Code, etc.).
// Not pulled from any billing API — see docs/deployment/COST_PLAYBOOK.md; this is
// the structured, queryable version of that doc, feeding the admin costs
// page's net-profit view alongside money-metrics.ts revenue. `vendor` is a
// curated key rather than a DB enum so a new vendor doesn't need a
// migration (see KNOWN_EXPENSE_VENDORS); "other" pairs with `vendorLabel`.
// Multiple rows per (vendor, periodMonth) are allowed and summed — lets an
// entry be corrected with an adjustment row instead of an edit.
model PlatformExpense {
  id             String          @id @default(cuid())
  vendor         String
  vendorLabel    String?         @map("vendor_label")
  category       ExpenseCategory
  amountMinorUnits Int             @map("amount_minor_units")
  // Native billing currency (Vercel/Anthropic/GitHub bill in USD; MXN is the
  // default for provenance, matching the `currency` convention on Payment/
  // SubscriptionInvoice). Net-profit totals only blend MXN rows — revenue is
  // MXN-only today (see money.ts) and this app has no FX-rate source, so
  // non-MXN rows are surfaced separately rather than silently converted.
  currency       String          @default("MXN")
  // First-of-month marker for the month this cost applies to (not an actual
  // charge timestamp — costs are entered after the fact, often from a
  // monthly invoice/statement).
  periodMonth    DateTime        @map("period_month") @db.Date
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([periodMonth])
  @@index([vendor, periodMonth])
  @@map("platform_expenses")
}

// Financial Intelligence estimate layer (D-86) — a registry of third-party
// integrations with a structured pricing model, kept deliberately SEPARATE
// from PlatformExpense above (actuals, hand-entered invoice totals). `key` is
// a stable slug (e.g. "vercel") used by seed-registry.ts for idempotent
// create-if-absent seeding of KNOWN_INTEGRATIONS — re-seeding never clobbers
// an admin's edits. `category` is TEXT validated against the shared
// `INTEGRATION_CATEGORIES` const rather than a Prisma enum, so a new category
// is a data change, not a migration (mirrors `vendor` above). `pricingModel`
// is the discriminated-union JSON the pure pricing engine
// (packages/shared/src/economics-pricing.ts) evaluates against usage —
// heterogeneous shapes (tiered arrays, hybrid combos) would force a migration
// per shape if normalized into columns.
model Integration {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  category     String   @default("other")
  purpose      String?  @db.Text
  pricingModel Json     @map("pricing_model")
  // Native billing currency (mostly USD); FX conversion to the GBP display
  // currency happens at the lib layer (assumptions.ts), never here.
  currency     String   @default("USD")
  billingModel String?  @map("billing_model")
  notes        String?  @db.Text
  billingUrl   String?  @map("billing_url")
  docsUrl      String?  @map("docs_url")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([category])
  @@index([active])
  @@map("integrations")
}

// One manually-entered usage reading per meter per calendar month (D-86) —
// the estimate layer's input to the pricing engine's `UsageValues`. `metric`
// is TEXT validated against the shared `USAGE_METRICS` const (same
// migration-free posture as Integration.category). `value` is a plain count/
// GB/minute — never money, unlike PlatformExpense.amountMinorUnits. `source`
// defaults to "manual" (finance-entered) with an "auto" value reserved for a
// future Inngest ingestion job (see the doc's Future extensibility section) —
// no schema change needed when that lands. The unique pair makes re-entering
// a month's reading an upsert rather than a duplicate row.
model UsageInput {
  id          String   @id @default(cuid())
  metric      String
  periodMonth DateTime @map("period_month") @db.Date
  value       Float
  source      String   @default("manual")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([metric, periodMonth])
  @@index([periodMonth])
  @@map("usage_inputs")
}

// Singleton (id="default") of the FX + allocation assumptions the estimate
// layer's lib layer (assumptions.ts) uses to convert every integration's
// native-currency cost into GBP pence (D-86 — GBP is the owner's
// money-of-record for this view per D-58) and to allocate shared costs across
// the profitability breakdowns. Manually maintained — this app has no live FX
// feed — so `fxAsOf` lets the UI show "FX as of {date}" rather than implying
// a live rate. Mirrors FoundingCohort's single-row-by-fixed-id pattern above.
model EconomicsAssumptions {
  id              String   @id @default("default")
  fxUsdToGbp      Float    @map("fx_usd_to_gbp")
  fxMxnToGbp      Float    @map("fx_mxn_to_gbp")
  fxEurToGbp      Float    @map("fx_eur_to_gbp")
  allocationBasis String   @default("active_teachers") @map("allocation_basis")
  fxAsOf          DateTime @map("fx_as_of") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("economics_assumptions")
}

// Single source of truth for the founding cohort headcount + cutoff. One row
// (id = "default"). The cutoff date / cap defaults live in config.ts; this row
// tracks the live headcount and lets ops override the cutoff if needed without
// a deploy. NOT tenant-scoped — platform-wide. Service-role only.
model FoundingCohort {
  id          String    @id @default("default")
  // Live count of teachers on a founding subscription. Incremented when a
  // founding subscription activates; the authoritative count is still
  // derivable from teacher_subscriptions, but this row makes the "is the
  // cohort open?" check a single cheap read.
  headcount   Int       @default(0)
  // Optional ops override of the config cutoff date. Null = use config.
  cutoffAt    DateTime? @map("cutoff_at") @db.Timestamptz
  // Optional ops override of the config headcount cap. Null = use config.
  maxTeachers Int?      @map("max_teachers")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("founding_cohort")
}

// Direct messages between a teacher and one of their students. Per-teacher
// tenancy mirrors the rest of the data model: each student row is scoped to
// one teacher, so (teacherId, studentId) identifies the thread uniquely.
// senderRole is "teacher" or "student" — we store the role rather than a
// userId so the display logic doesn't need to cross-reference auth tables.
model Message {
  id               String    @id @default(cuid())
  teacherId        String    @map("teacher_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  senderRole       String    @map("sender_role") // "teacher" | "student"
  body             String?   @db.Text // null for voice-only or video-only messages
  voiceStoragePath String?   @map("voice_storage_path")
  voiceDurationMs  Int?      @map("voice_duration_ms")
  videoStoragePath String?   @map("video_storage_path")
  videoDurationMs  Int?      @map("video_duration_ms")
  // Inline photo attachment (WhatsApp-style): stored the same way as
  // voice/video (dedicated R2 bucket, presigned direct upload).
  imageStoragePath String?   @map("image_storage_path")
  imageWidth       Int?      @map("image_width")
  imageHeight      Int?      @map("image_height")
  // Document attachment (pdf/doc/xls/ppt/txt/zip — no executables).
  fileStoragePath  String?   @map("file_storage_path")
  fileName         String?   @map("file_name")
  fileSizeBytes    Int?      @map("file_size_bytes")
  fileMimeType     String?   @map("file_mime_type")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  readAt           DateTime? @map("read_at") @db.Timestamptz
  // WhatsApp-style edit: set when the sender edits a text message's body
  // (15-minute window, media messages never editable — both enforced in
  // lib/chat/message-actions.ts). Clients render an "edited" label.
  editedAt         DateTime? @map("edited_at") @db.Timestamptz
  // "Delete for everyone" tombstone: the row is kept so both sides render
  // "This message was deleted" in place, but body + media columns are nulled
  // at delete time (and the R2 object removed) so the content is really gone.
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  // Optional reply-to/quote pointer. SetNull on delete so quoting a message
  // that's later deleted-for-everyone just drops the quote link, rather than
  // taking the replying message down with it.
  replyToId        String?   @map("reply_to_id")

  teacher   Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]
  replyTo   Message?          @relation("MessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplyTo")

  @@index([teacherId, studentId, createdAt])
  @@index([replyToId])
  @@map("messages")
}

// One reaction per person per message (WhatsApp semantics): reacting again
// with a different emoji replaces it; reacting again with the same emoji
// removes it. Enforced by the unique constraint + toggleMessageReaction in
// lib/chat/message-actions.ts. Either thread participant may react to any
// message (not sender-restricted, unlike edit/delete).
model MessageReaction {
  id          String   @id @default(cuid())
  messageId   String   @map("message_id")
  reactorRole String   @map("reactor_role") // "teacher" | "student"
  emoji       String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorRole])
  @@map("message_reactions")
}

// ---------------------------------------------------------------------------
// better-auth (D-40) — authentication tables owned in OUR Postgres, replacing
// Supabase Auth (GoTrue). Generated by `@better-auth/cli generate` for our plugin
// set (emailOTP + twoFactor + bearer + admin), so `generate` stays a no-op on
// upgrades. Every id / userId is `@db.Uuid` (via advanced.database.generateId:
// "uuid") so the existing `@db.Uuid` FKs on teachers.id and students.auth_user_id
// can re-point here (migration, task 3). These tables use better-auth's own
// camelCase column convention deliberately — they are its tables, not the app's.
// Plan: docs/features/authentication.md.

model User {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  twoFactorEnabled Boolean?    @default(false)
  role             String?
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  // App-side identities keyed off this row (D-40 FK re-point — migration
  // 20260704020000_fk_repoint_teachers_students_to_user). `teacher` is the
  // shared-primary-key one-to-one side; `students` is one-to-many since the
  // same person can be a Student under several teachers (multi-teacher
  // tenancy — see the Student model's own comment).
  teacher          Teacher?
  students         Student[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // One link per (provider, provider-side account id) — prevents a Google
  // account (or any social provider) from being linked twice. better-auth
  // upserts on this pair; the DB unique index makes it authoritative.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// --- Social previews (D-123) -------------------------------------------------

// How the image behind a social preview came to exist. `upload` and `ai` are
// the two MVP rails and deliberately share ONE asset model, so the surface that
// picks/renders an image never branches on provenance. Room is left for
// `template` (a house layout filled with teacher data) and `system` (something
// the platform generated unprompted) without a migration to the consuming code.
enum SocialPreviewSource {
  upload
  ai
  template
  system

  @@map("social_preview_source")
}

// The single configuration dimension a teacher picks when generating (D-123).
// Deliberately ONE axis, not purpose x style: for this audience the two are
// ~95% correlated, and a 24-cell matrix multiplies analytics cardinality before
// there is a single data point to break down. Named `angle` (not `type`/`style`)
// precisely so a second dimension can be ADDED later without renaming this one.
enum SocialPreviewAngle {
  meme
  promo
  tip
  motivation

  @@map("social_preview_angle")
}

// One stored image asset a teacher can attach to a share link — either uploaded
// by her or generated by the platform image model. Also THE generation ledger:
// counting rows with `source = ai` since the month start is the monthly-cap
// check, exactly the idiom ClassContentGeneration uses for material compose, so
// there is no second table to keep in sync.
//
// The stored bytes are the BACKGROUND ONLY — never the finished card. All text
// (caption, teacher name, brand) is rendered over this by Satori at serve time
// (/api/og/social-preview/[id]); the image model is explicitly instructed to
// produce no letters at all. See D-123 for why: a misspelled Spanish meme
// posted by a Spanish teacher inverts the whole value proposition, and keeping
// text out of the asset makes a caption edit free, instant and provider-free.
model SocialPreviewImage {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String              @map("teacher_id") @db.Uuid
  source      SocialPreviewSource
  // Null for an untagged upload — the teacher never had to declare an angle.
  // Present for every AI generation (it IS the generation input) and readable
  // as an analytics breakdown dimension.
  angle       SocialPreviewAngle?
  // The teacher's own words ("students learning Mexican Spanish"), NOT the
  // provider prompt. Kept so "generate another" can re-run her intent without
  // making her retype it.
  topic       String?
  // The full text actually sent to the provider — provenance + reproducibility
  // + an audit trail if a generation is ever reported as inappropriate.
  prompt      String?
  provider    String?
  model       String?
  // Object key inside the PUBLIC teacher-photos bucket, under the teacher's own
  // prefix (`<teacherId>/social/<id>.<ext>`) — same namespacing testimonial
  // avatars use. No new bucket: this one is already public and CDN-fronted,
  // which social crawlers require (they fetch without auth).
  storagePath String              @map("storage_path")
  width       Int
  height      Int
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  teacher    Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  previews   SocialPreview[]
  // Marketing activities that attached this asset (D-125) — the same generated
  // background, reused as a post image rather than regenerated.
  activities MarketingActivity[]

  // Serves both the library listing and the monthly-cap count.
  @@index([teacherId, createdAt])
  @@map("social_preview_images")
}

// One placement: "when someone shares THIS link, preview it with THIS image and
// THIS caption". Attached to the share GROUP rather than to the teacher's
// booking page, because the same booking page is promoted differently in
// different places — a funny meme in one Facebook group, a clean promotional
// card in another (D-123).
//
// `shareGroupId = null` is the teacher's DEFAULT custom preview: what an
// untagged /b/<slug> share (a WhatsApp broadcast, a bio link) uses. A teacher
// with neither a group preview nor a default keeps the built-in OG card, so
// every existing shared link is unaffected.
//
// Uniqueness note: `shareGroupId` is @unique, which bounds a group to one
// preview, but Postgres allows many NULLs under a unique index, so it does NOT
// bound the teacher-default row to one. That is enforced in the application layer
// (lib/social-preview/store.ts upserts the default inside a transaction)
// rather than with a partial unique index, because a partial index is not
// expressible in the Prisma schema and would read as permanent drift to the
// migration-drift gate. Resolution is deterministic regardless (newest wins).
model SocialPreview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  // Globally @unique (a group belongs to exactly one teacher, so this also
  // means "at most one preview per group"). Postgres allows many NULLs under a
  // unique index, which is what leaves the teacher-default row to the
  // application-layer guard described above.
  shareGroupId String?  @unique @map("share_group_id") @db.Uuid
  imageId      String   @map("image_id") @db.Uuid
  // Rendered by us over the image, never by the model. Empty string = image only.
  caption      String   @default("")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  // Doubles as the og:image cache-buster (`?v=`): Facebook and WhatsApp cache
  // the first scrape of a URL, so a changed preview MUST produce a changed URL.
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  teacher    Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  shareGroup TeacherShareGroup? @relation(fields: [shareGroupId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting an asset that a live share link still
  // previews would silently break every already-posted link pointing at it.
  image      SocialPreviewImage @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([teacherId])
  @@index([imageId])
  @@map("social_previews")
}

// --- Student acquisition (D-125) ---
//
// Four models turn SpiralClass from "software that manages the students a
// teacher already has" into "software that helps her get the next one". They
// are deliberately few: a marketing suite's usual dozen tables buys generality
// nobody here needs, and every extra table is a join between a teacher and an
// answer.
//
//   TeacherMarketingProfile — the small amount that CANNOT be inferred.
//   MarketingPlan           — one week's prepared work.
//   MarketingActivity       — one prepared action, and its tracked link.
//   AcquisitionEvent        — the funnel ledger everything else is measured by.
//
// The community entity is TeacherShareGroup above, generalised in place.

// The minimum a teacher has to tell us that we cannot read off her account.
//
// Everything omitted here is INFERRED at generation time from data she has
// already given: what she teaches (teachers.target_language), the language she
// teaches in, her country/timezone, her packages and prices, her availability,
// her bio and headline, her published testimonials, her photo, her students.
// Asking for any of that again would be the "minimum input, maximum output"
// promise broken on the first screen.
model TeacherMarketingProfile {
  teacherId               String   @id @map("teacher_id") @db.Uuid
  // Who she wants: free-text audience descriptors ("expats", "professionals",
  // "kids"). An array rather than an enum because the useful answer is
  // local and specific, and a curated enum would be wrong within a month.
  audiences               String[] @default([])
  // Where those learners are ("Oaxaca", "USA", "remote"). Same reasoning.
  learnerLocations        String[] @default([]) @map("learner_locations")
  // CEFR-ish level focus ("beginner", "intermediate", "advanced"), free-form
  // for the same reason.
  levels                  String[] @default([])
  // One line in her own words: what makes her different. This is the single
  // highest-value field in the model — it is what stops generated content
  // reading like every other teacher's.
  differentiator          String?  @map("differentiator")
  // How many minutes a week she is willing to spend on getting students. The
  // planner sizes the week to this; it is the field that makes the product
  // feel considerate rather than demanding.
  weeklyMinutes           Int      @default(60) @map("weekly_minutes")
  // Her own goal, used only as framing in the UI — never as a promise.
  goalNewStudentsPerMonth Int      @default(2) @map("goal_new_students_per_month")
  // Her general image-generation instructions, reused for every community: her
  // niche, her humour, her audience, what she never wants to see. This is the
  // fix for every teacher on the platform sharing one hardcoded brief — see
  // packages/shared/src/marketing/meme.ts for why the generated memes were all
  // the same surprised person.
  memeBrief               String?  @map("meme_brief")
  // Preferred visual register — a MemeStyle from @spiralclass/shared,
  // app-validated like every other vocabulary column here. `varied` is the
  // default and rotates the look on every generation.
  memeStyle               String   @default("varied") @map("meme_style")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_marketing_profiles")
}

enum MarketingActivityStatus {
  // Planned but the content has not been generated yet.
  planned
  // Content (and image, where wanted) is prepared and waiting for her.
  ready
  // She marked it done — posted, sent, replied.
  done
  // She skipped it. Recorded rather than deleted: a skipped kind or community
  // is a signal the next plan should read.
  skipped

  @@map("marketing_activity_status")
}

// One week of prepared work for one teacher. Regenerating a week replaces its
// activities that are still `planned`; anything she already acted on survives,
// so a regenerate can never erase her history.
model MarketingPlan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId     String   @map("teacher_id") @db.Uuid
  // Monday 00:00 UTC of the plan's week. Unique per teacher so a plan is
  // idempotent to generate.
  weekStart     DateTime @map("week_start") @db.Date
  // Minutes the plan was sized for, captured at generation so a later profile
  // change doesn't retroactively rewrite what she was asked to do.
  weeklyMinutes Int      @default(60) @map("weekly_minutes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  teacher    Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  activities MarketingActivity[]

  @@unique([teacherId, weekStart])
  @@index([teacherId, weekStart])
  @@map("marketing_plans")
}

// One prepared acquisition action: what to post, where, with which image, and
// the tracked link that closes the loop back to a booking.
//
// This is also the "campaign" entity. A separate campaign table was considered
// and rejected (D-125): for one independent teacher a campaign IS the activity,
// and the grouping she actually thinks in — "this week" — is the plan.
model MarketingActivity {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId    String                  @map("teacher_id") @db.Uuid
  planId       String?                 @map("plan_id") @db.Uuid
  // Null for an activity that isn't tied to a saved community (a referral ask,
  // an ad-hoc WhatsApp broadcast).
  communityId  String?                 @map("community_id") @db.Uuid
  // MarketingContentKind + MarketingPlatform from @spiralclass/shared,
  // app-validated for the same reason `platform` is on the community.
  kind         String
  platform     String
  status       MarketingActivityStatus @default(planned)
  // The generated post. Null until generation runs.
  body         String?
  // Optional short headline/subject the generator produced (Instagram caption
  // hook, Reddit title).
  title        String?
  // The model's own one-line note on the angle it took — shown to the teacher
  // so an edit is an informed edit.
  angleNote    String?                 @map("angle_note")
  // Structured reason this action is in the plan (a PlanReason from the shared
  // planner). Stored, not recomputed, so the teacher always reads the reason
  // that was true when the plan was made.
  reason       Json?
  // The generated background image reused from the D-123 social-preview
  // pipeline. Restrict, not Cascade: an image a posted activity references
  // must not vanish underneath it.
  imageId      String?                 @map("image_id") @db.Uuid
  // Referral asks target one student.
  studentId    String?                 @map("student_id") @db.Uuid
  // The tracked-link token. Unique platform-wide; resolved by /g/<code>, which
  // stamps attribution and records the visit before redirecting to the
  // teacher's booking page. Null for activities that carry no link (a Reddit
  // comment, by policy).
  trackingCode String?                 @unique @map("tracking_code")
  // Teacher's own note, and when she acted.
  notes        String?
  completedAt  DateTime?               @map("completed_at") @db.Timestamptz
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  teacher   Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  plan      MarketingPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  community TeacherShareGroup?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  image     SocialPreviewImage? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  student   Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  events    AcquisitionEvent[]

  @@index([teacherId, status, createdAt])
  @@index([planId])
  @@index([communityId])
  @@map("marketing_activities")
}

enum AcquisitionEventKind {
  // A visitor landed on the teacher's public booking page.
  visit
  // A visitor submitted the contact form.
  enquiry
  // A visitor started checkout (a Package row exists, still pending).
  booking
  // That purchase settled — a paying student.
  purchase

  @@map("acquisition_event_kind")
}

// The acquisition ledger: one append-only row per funnel step, carrying the
// attribution that produced it.
//
// This table is the reason the whole feature can learn. Before it, first-touch
// attribution existed but went ONLY to PostHog (see
// lib/analytics/attribution.ts), which means the product itself could never
// answer "which community produced a paying student" — the exact question the
// planner and the results screen are built on. PostHog stays where it is;
// this is the in-product, teacher-owned copy.
//
// Privacy posture (D-125): no IP address, no user agent, no referrer path —
// only an origin, the UTM values already capped and charset-limited by
// lib/analytics/attribution.ts, and a rotating first-party visitor hash that
// is never joined to anything outside this teacher's own funnel.
model AcquisitionEvent {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId      String               @map("teacher_id") @db.Uuid
  kind           AcquisitionEventKind
  occurredAt     DateTime             @default(now()) @map("occurred_at") @db.Timestamptz
  // Salted hash of the first-party visitor cookie. Lets visit -> enquiry ->
  // purchase be stitched into a funnel without storing anything that
  // identifies a person outside this teacher's own data.
  visitorHash    String?              @map("visitor_hash")
  // First-touch attribution, as captured by the existing ap_src cookie.
  source         String?
  medium         String?
  campaign       String?
  content        String?
  referrer       String?
  // Resolved links. `activityId` is set when the visitor arrived through a
  // tracked /g/<code> link; `communityId` is resolved either from that
  // activity or from a `utm_content` share-group slug.
  activityId     String?              @map("activity_id") @db.Uuid
  communityId    String?              @map("community_id") @db.Uuid
  leadId         String?              @map("lead_id") @db.Uuid
  studentId      String?              @map("student_id") @db.Uuid
  packageId      String?              @map("package_id") @db.Uuid
  // Settled purchase value, in the payment's own currency. Only on `purchase`.
  amountMinorUnits Int?                 @map("amount_minor_units")
  currency       String?
  // True when this purchase came through a student referral code — the
  // referral rail is a first-class acquisition channel, not a discount detail.
  viaReferral    Boolean              @default(false) @map("via_referral")

  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  activity  MarketingActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  community TeacherShareGroup? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([teacherId, kind, occurredAt])
  @@index([teacherId, occurredAt])
  @@index([activityId])
  @@index([communityId])
  // Purchase promotion reads the earlier `booking` row back by package.
  @@index([packageId])
  @@map("acquisition_events")
}
