# Copy to .env.local and fill in. Never commit .env.local.
#
# `src/lib/env.ts` is the authoritative runtime env contract — every var below
# is either validated there (server/client schema) or read straight from
# process.env by the module named in its comment. Adding a var? Add it to
# env.ts AND here (the PR template's security checklist holds you to it).
#
# Almost everything is OPTIONAL and degrades gracefully when missing (the UI
# hides, a stub client answers, or the feature stays dark) — a minimal local
# setup is just the Database + App sections. What production hard-requires is
# enforced by assertProductionCredentials() in env.ts, not by this file.

# --- Database (Postgres — Neon in deployed environments) ---
# Pooled connection for app runtime; direct connection for Prisma migrations.
# Any Postgres works locally, and `pnpm setup` starts one in Docker. A free
# Neon dev branch works too — point both URLs at it. After filling in:
#   pnpm --filter spiralclass-web prisma:migrate:deploy   # apply migrations
#   pnpm --filter spiralclass-web seed                    # dev fixtures
DATABASE_URL=
DIRECT_URL=
# Multi-region migrations (D-49). LEAVE BLANK for single-region: the migrate
# runner (scripts/migrate-regions.ts) falls back to DATABASE_URL/DIRECT_URL
# above. To migrate a fleet, set a JSON array of
# {"name","databaseUrl","directUrl"} regions. Treat as a secret — it holds
# connection strings.
MIGRATE_REGIONS=
# Integration tests only (vitest `integration` project; lives in .env.test,
# not .env.local). `pnpm test:integration:local` boots a disposable
# postgres:16 on :5433 via docker-compose.test.yml and points this at it.
# Never read by production code.
TEST_DATABASE_URL=
# Seed-script safety guard (scripts/seed.ts): comma-separated DB hostnames the
# seed refuses to touch. Set in deploy environments to the production host.
PROD_DB_HOSTS=
# The two real people the seed bootstraps accounts for: the operator, as
# superadmin, and the pilot teacher, as a tester doing manual UAT through an
# inbox she can read. Their addresses are NOT in the source — this repository is
# public (docs/security.md) — so set them here on preview and leave them unset
# anywhere else. Unset falls back to `.invalid` addresses that RFC 2606
# guarantees can never route mail, which is what stops an unset variable from
# quietly granting superadmin to an address a stranger could register.
SEED_OPERATOR_EMAIL=
SEED_PILOT_TEACHER_EMAIL=

# --- App ---
# Canonical origin for absolute URLs (auth callbacks/magic links, Stripe
# return/refresh URLs, /r/* short links) AND the prod-vs-preview signal
# (isProductionDeployment: a host containing "preview" reads as non-prod).
# http://localhost:3000 for local dev; defaults to https://spiralclass.com.
APP_URL=http://localhost:3000
# HMAC key for the /r/* short-link + notification opt-out capability tokens
# (>= 16 chars). NOT the auth session secret — that's BETTER_AUTH_SECRET.
SESSION_SECRET=
# better-auth (D-40 — the auth rail): signing secret for sessions + bearer
# tokens (>= 32 chars; `openssl rand -base64 32`). Sign-in doesn't work
# without it. BETTER_AUTH_URL defaults to APP_URL — leave blank normally.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Google Sign-In (login; better-auth social provider) ---
# A SEPARATE OAuth client from the Calendar busy-import further down —
# different purpose, scopes, and consent screen. Either unset → the
# "Continuar con Google" button is hidden and email OTP stays the only rail.
# Authorized redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (student→teacher payments rail) ---
# Platform secret + Connect webhook secret. Unset → stub Stripe client and
# the Connect UI hides (Wise-only mode) — fine for dev; production logs a
# boot warning and runs Wise-only rather than failing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_*) for Embedded Checkout + embedded Connect components.
# Not a secret; unset → both fall back to Stripe-hosted redirects.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Billing — the teacher's own SpiralClass subscription
# (docs/features/subscriptions.md). Runs on the SAME platform key, with a
# SEPARATE webhook endpoint + secret (/api/stripe/billing-webhook). Price IDs
# are created out-of-band in the Stripe dashboard (GBP as of D-99). Any of
# these missing → the paywall hides and every teacher stays on Free/trial.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_FOUNDING=
STRIPE_BILLING_WEBHOOK_SECRET=
# The Customer Portal configuration DECLARED IN THIS REPO
# (src/lib/stripe/portal-configuration.ts), applied by
# `pnpm --filter spiralclass-web stripe:portal:sync --apply`, which prints the
# id to paste here. Unset, Stripe opens the account default it creates lazily
# from its own defaults — the portal still works, but plan switching is off and
# the cancel policy is whatever the Dashboard last said. Deliberately NOT part
# of hasBillingCreds(): billing must not go dark over an unpinned portal.
STRIPE_BILLING_PORTAL_CONFIG_ID=
# "1"/"true" enables Stripe Tax (automatic_tax) at checkout on both rails.
# Off by default — it has prerequisites outside the codebase that the flag
# does not enforce, so it is never a config default.
STRIPE_TAX_ENABLED=

# --- Wise (parallel payments rail) ---
# Manual-confirmation mode needs NO platform credentials: each teacher
# configures their own Wisetag in /settings/payments. Automated
# reconciliation credentials are PER-TEACHER (stored encrypted on the Teacher
# row) — the only platform-wide knob is the sandbox override:
# https://api.sandbox.transferwise.tech (blank = production API).
WISE_API_BASE=

# --- Email ---
# SES is preferred when both providers are configured (metered, no monthly
# floor); Resend is the fallback; neither → stub client that only logs.
# EMAIL_PROVIDER ("ses"|"resend") forces one, e.g. to roll back to Resend
# without unsetting SES creds. Production requires SES *or* Resend.
RESEND_API_KEY=
RESEND_FROM=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM=
EMAIL_PROVIDER=

# --- Background jobs (Inngest) ---
# Async email/push, transfer-on-paid, recurring crons (src/lib/inngest/).
# Unset → stub client (events become no-op logs); the /api/inngest handler
# still works locally with `npx inngest-cli dev`. Required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# "inngest" (default) or "pgboss" — selects the enqueue backend
# (lib/jobs/enqueue.ts). Leave blank; flipping is a deliberate cutover step.
JOBS_BACKEND=

# --- Anomaly detection thresholds (hourly scan, lib/inngest/functions/anomaly-alerts.ts) ---
# How many of each signal in a one-hour window raise a Sentry alert. Blank →
# the in-code defaults, which are deliberately NOT the deployed values: a
# public repository that states the live numbers tells a reader exactly how
# much abuse stays under the alarm. Set these per environment.
ANOMALY_REFUND_THRESHOLD=
ANOMALY_REFUND_PER_TEACHER_THRESHOLD=
ANOMALY_TEACHER_DISABLE_THRESHOLD=
ANOMALY_STUDENT_DISABLE_THRESHOLD=
ANOMALY_FAILED_NOTIFICATIONS_THRESHOLD=
ANOMALY_FAILED_PAYMENTS_THRESHOLD=
ANOMALY_PUSH_FAILURE_THRESHOLD=

# --- Rate limits (per scope) ---
# Every `rateLimit()` call site ships a working default so a fresh checkout
# runs unconfigured. The limits a deployment actually enforces are set here,
# per environment, and override the default at runtime:
#
#   RATE_LIMIT_<SCOPE>=<max requests per window>
#   RATE_LIMIT_<SCOPE>_WINDOW_MS=<window length in ms>
#
# <SCOPE> is the call site's `scope`, upper-cased with non-alphanumerics
# replaced by `_` — scope "sign-in-email" reads RATE_LIMIT_SIGN_IN_EMAIL.
# A blank or unparseable value falls back to the in-code default, so a typo
# degrades to the default rather than removing the limit. Scopes in use:
# sign-in, sign-in-email, sign-up, sign-up-email, verify-web-code,
# mobile-request-otp-ip, mobile-request-otp-email, mobile-verify-otp-ip,
# mobile-verify-otp-email, mobile-request-signup-otp,
# mobile-request-signup-otp-email, mobile-google-signin-ip, email-change,
# lead-capture, lead-capture-sender, checkout-create, checkout-create-buyer,
# transfer-instructions-ip, admin-live-calls-action, marketing-content,
# social-preview-generate.

# --- AI: Anthropic (lesson summaries/briefs, class-content compose,
# caption translation) ---
# Unset → AI actions return a friendly error; dev + tests run without it.
# ANTHROPIC_MODEL overrides the class-content compose model only (default
# claude-sonnet-5; must support output_config.effort — see anthropicModel()).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- AI: lesson-insights transcription (D-19 Phase B) ---
# Dormant until the flag is on AND an ASR vendor key is present (only the
# Deepgram adapter is wired today).
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
LESSON_INSIGHTS_TRANSCRIPTION_ENABLED=

# --- AI: pronunciation scoring (D-19 Phase D, Azure AI Speech) ---
# Same dormant-until-configured pattern; note this streams student audio to a
# second vendor (D-21 consent coverage applies).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
LESSON_INSIGHTS_PRONUNCIATION_ENABLED=

# --- AI: live in-class captions (D-27) ---
# Reuses DEEPGRAM_API_KEY (streaming ASR) + ANTHROPIC_API_KEY (translation).
# The teacher's Subtitles toggle appears only when the flag is on AND both
# keys are present — any one missing hides it silently, with no error
# (lib/captions/config.ts), an easy thing to forget on a new environment.
LIVE_CAPTIONS_ENABLED=
# Optional override for the (fast, cheap) translation model; defaults to
# claude-haiku-4-5.
CAPTION_TRANSLATION_MODEL=
# Shared secret authenticating the self-hosted captions agent
# (packages/livekit-captions-agent) to /api/internal/captions/*. Absent →
# those routes 404 (dark by default). Must be set in preview AND production.
CAPTIONS_AGENT_SHARED_SECRET=

# --- AI: other per-feature kill-switches ---
# Same dark-by-default shape ("1"/"true"/"on" AND the vendor creds present).
HOMEWORK_AUDIO_TRANSCRIPTION_ENABLED=
INTRO_CALLS_ENABLED=
INTRO_VIDEO_COACH_ENABLED=

# --- AI: material podcasts (text-to-speech) ---
# Google TTS is the preferred rail (cheap, free monthly Neural2 tier, not
# blocked from datacenter IPs); ElevenLabs is the fallback. BOTH the flag AND
# a TTS key are required (D-114) — either missing hides the "Generate
# podcast" action and the server refuses the request. Voice/model/language
# overrides are optional; sensible defaults live in env.ts / google-tts.ts.
MATERIAL_PODCASTS_ENABLED=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=
GOOGLE_TTS_LANGUAGE_CODE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Social previews (D-123) ---
# The per-share-link OG/social image a teacher uploads or generates. Same
# two-condition shape as podcasts above (D-114): BOTH the flag AND a
# credential are required, and either missing hides "Generate with AI" and
# makes the server refuse the request. Uploading an image, and every
# already-shared link, keep working regardless — the AI half is the only
# thing these gate.
#
# Served through VERTEX AI, not the public Generative Language API (D-127) —
# billing, not model, is why: Vertex bills through ordinary (postpaid) Cloud
# Billing, while AI Studio's API-key surface gates every call on a separate
# prepay balance with no postpaid option. GEMINI_VERTEX_SERVICE_ACCOUNT_KEY_BASE64
# is a service account key JSON, base64-encoded onto one line (`base64 -i
# key.json`) — Vertex has no bare-API-key auth path. GEMINI_IMAGE_MODEL and
# GEMINI_VERTEX_LOCATION are optional; their defaults live in env.ts.
SOCIAL_PREVIEW_AI_ENABLED=
GEMINI_VERTEX_SERVICE_ACCOUNT_KEY_BASE64=
GEMINI_VERTEX_PROJECT_ID=
GEMINI_VERTEX_LOCATION=
GEMINI_IMAGE_MODEL=

# --- Video calls (LiveKit, D-16) ---
# Self-hosted or LiveKit Cloud. Missing any of the three → call/join buttons
# hide gracefully; missing creds ARE the off switch (no separate flag).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Selects the VideoProvider implementation; only "livekit" exists today and
# unset defaults to it.
RTC_PROVIDER=
# Class recording (LiveKit Egress): explicit flag, OFF by default — NOT
# auto-on merely because the egress bucket (LIVEKIT_EGRESS_S3_* below) is
# configured, because recording a lesson carries the same consent weight as
# captioning it (D-21/D-22). lib/video/recording.ts.
CLASS_RECORDING_ENABLED=

# --- Object storage (Cloudflare R2) ---
# One env-var prefix per logical bucket: <PREFIX>_BUCKET/_ENDPOINT/
# _ACCESS_KEY/_SECRET/_REGION (region defaults to "auto" for R2). The
# bucket→prefix map is R2_ENV_PREFIX in lib/storage/provider.ts and mirrors
# infra/cloudflare-r2/variables.tf 1:1 — keep the three in sync. ENDPOINT
# format: https://<account-id>.r2.cloudflarestorage.com. All optional: an
# unconfigured bucket makes its feature report "not configured", never crash.
#
# teacher-photos + teacher-videos are PUBLIC buckets (enable public access /
# a custom domain in Cloudflare and set the NEXT_PUBLIC_*_PUBLIC_URL base);
# everything else is PRIVATE, served via short-lived signed URLs only.
TEACHER_PHOTOS_R2_BUCKET=
TEACHER_PHOTOS_R2_ENDPOINT=
TEACHER_PHOTOS_R2_ACCESS_KEY=
TEACHER_PHOTOS_R2_SECRET=
TEACHER_PHOTOS_R2_REGION=auto
NEXT_PUBLIC_TEACHER_PHOTOS_R2_PUBLIC_URL=

TEACHER_VIDEOS_R2_BUCKET=
TEACHER_VIDEOS_R2_ENDPOINT=
TEACHER_VIDEOS_R2_ACCESS_KEY=
TEACHER_VIDEOS_R2_SECRET=
TEACHER_VIDEOS_R2_REGION=auto
NEXT_PUBLIC_TEACHER_VIDEOS_R2_PUBLIC_URL=

STUDENT_PHOTOS_R2_BUCKET=
STUDENT_PHOTOS_R2_ENDPOINT=
STUDENT_PHOTOS_R2_ACCESS_KEY=
STUDENT_PHOTOS_R2_SECRET=
STUDENT_PHOTOS_R2_REGION=auto

CLASS_MATERIALS_R2_BUCKET=
CLASS_MATERIALS_R2_ENDPOINT=
CLASS_MATERIALS_R2_ACCESS_KEY=
CLASS_MATERIALS_R2_SECRET=
CLASS_MATERIALS_R2_REGION=auto

CHAT_AUDIO_R2_BUCKET=
CHAT_AUDIO_R2_ENDPOINT=
CHAT_AUDIO_R2_ACCESS_KEY=
CHAT_AUDIO_R2_SECRET=
CHAT_AUDIO_R2_REGION=auto

MATERIAL_PODCASTS_R2_BUCKET=
MATERIAL_PODCASTS_R2_ENDPOINT=
MATERIAL_PODCASTS_R2_ACCESS_KEY=
MATERIAL_PODCASTS_R2_SECRET=
MATERIAL_PODCASTS_R2_REGION=auto

# Class recordings (LiveKit Egress writes here; named _S3_ because the vars
# predate the R2 naming rule — see the provider.ts comment).
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_REGION=auto

# --- Observability ---
# All optional in dev (no-op clients); Sentry + PostHog are required in
# production. SENTRY_DSN is server-side; NEXT_PUBLIC_SENTRY_DSN reaches the
# browser bundle. POSTHOG_KEY (phc_*) drives the server-side event pipeline;
# the browser SDK uses the NEXT_PUBLIC_POSTHOG_* keys and ingests through the
# /ingest reverse proxy, so NEXT_PUBLIC_POSTHOG_HOST is only an escape hatch.
# POSTHOG_HOST overrides the server ingestion host (blank = derived from
# NEXT_PUBLIC_POSTHOG_REGION, default us; the project itself is
# dashboard-pinned to one region — D-48). POSTHOG_PERSONAL_API_KEY (phx_*)
# enables local server-side feature-flag evaluation (optional).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
POSTHOG_PERSONAL_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_REGION=us

# Support WhatsApp number (digits + country code, e.g. 5215512345678). When
# set, a "Chat on WhatsApp" CTA appears in every authenticated nav,
# pre-filled with the user's PostHog session replay URL + current page.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Super-user admin panel ---
# Comma-separated emails allowed to reach /admin (merged with
# BUILTIN_SUPERUSERS in env.ts, which ships empty). Empty → /admin is closed
# to everyone. (This also gates the mobile admin screens — a separate
# mechanism from the web AdminUser table; see docs/features/admin-portal.md.)
SUPERUSER_EMAILS=

# --- Rate limiter ---
# When both are set, src/lib/rate-limit.ts routes to Upstash Redis instead of
# the single-region in-memory bucket. Safe to leave blank for dev and
# single-region deploys. upstash.com → Redis → "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Field-level encryption (PII at rest) ---
# 32 random bytes, base64 (`openssl rand -base64 32`). Unset → the helpers
# return null and PII columns stay plaintext (the pre-rollout state). The
# REQUIRED cutover flag makes production refuse to boot without a valid key —
# set it only in the same release that swaps readers/writers to ciphertext.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_REQUIRED=

# --- Google Calendar busy-import ---
# OAuth client (Web application type) for the read-only Calendar connection
# teachers opt into — the slot generator then avoids offering slots over
# personal events. Both unset → the feature is dormant (Connect button
# hidden, sync cron no-ops). Distinct from the Sign-In client above.
# Redirect URI: ${APP_URL}/api/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Web Push (browser notifications) ---
# The browser transport of the `push` notification channel — see
# docs/features/notifications.md. A signed-in web session
# that turns notifications on registers a subscription; the dispatcher fans out
# to it alongside any Expo tokens.
#
# Generate the keypair ONCE with `npx web-push generate-vapid-keys` and keep it
# stable: the public key is baked into every subscription a browser mints, so
# rotating it silently invalidates all of them.
#
# All three absent = the transport simply doesn't exist. The toggle hides
# itself, stored subscriptions don't count toward push-reachability, and those
# recipients get email instead. A HALF-configured deploy reads as unconfigured
# rather than as configured-and-broken.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https URL the push service can use to contact us. Required by the
# VAPID spec.
VAPID_SUBJECT=

# --- Maintenance mode (D-76) ---
# "1"/"true"/"on" takes BOTH apps offline for a planned window: web serves a
# localized 503 wall, mobile shows a maintenance gate (via /api/mobile/config
# polling). Read straight from process.env (works in middleware even when the
# DB is what's under maintenance) — see lib/maintenance.ts and
# docs/deployment/RELEASE_AND_STAGING.md § Maintenance windows.
MAINTENANCE_MODE=
# Optional operator copy / ETA shown on both walls.
MAINTENANCE_MESSAGE=
MAINTENANCE_UNTIL=
# Optional secret: ?maintenance_bypass=<value> sets a cookie so the operator
# can verify the fix through the wall. Unset = bypass disabled.
MAINTENANCE_BYPASS_TOKEN=

# --- Content-Security-Policy override ---
# Forces the CSP mode regardless of environment ("1" = enforce, "0" =
# report-only) — see src/lib/csp.ts for the default per environment. Leave
# blank locally.
CSP_ENFORCE=

# --- Test/E2E-only escape hatches (NEVER set in a real deployment) ---
# E2E_STRIPE_STUB: serve the in-memory Stripe stub even under a production
# build — how the hermetic E2E gate runs. E2E_RATE_LIMIT_BYPASS: skip the
# sign-in OTP rate limiters (E2E re-sends codes faster than any real user).
E2E_STRIPE_STUB=
E2E_RATE_LIMIT_BYPASS=

# ---------------------------------------------------------------------------
# Ambassador commission
# ---------------------------------------------------------------------------
# Whole percent of the NET of a referred teacher's paid subscription invoices
# that is payable to the ambassador who referred them, over that teacher's
# first COMMISSION_WINDOW_MONTHS. A commercial term, so it is configuration
# rather than a source constant.
#
# Unset, blank, non-numeric or outside 1-100 resolves to 0: the admin report
# then shows a zero payable, which is visibly unconfigured rather than a
# plausible number a manual transfer could be made against. Nothing pays out
# automatically either way -- the report is a reporting tool.
COMMISSION_RATE_PERCENT=
